<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Persistence (EF Core over SQL Server — constitution: Persistence) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" />

    <!-- Health checks (liveness/readiness — constitution Principle VII; research.md Decision 3).
         The EntityFrameworkCore package supplies AddDbContextCheck<T>(), which readiness uses to
         prove real connectivity to the service's own database rather than probing a raw socket. -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.SqlServer" Version="9.0.0" />

    <!-- Observability (constitution Principle VII). Pinned to 1.17.0, not 1.10.x —
         OpenTelemetry.Api/Exporter.OpenTelemetryProtocol 1.10.0 carry known moderate-severity
         advisories (GHSA-8785-wc3w-h8q6, GHSA-g94r-2vxg-569j, GHSA-4625-4j76-fww9). -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />

    <!-- Contract generation (ADR-0003/ADR-0004; 002-gateway-bff-routing research.md Decision 6).
         The native ASP.NET Core OpenAPI generator, deliberately not Swashbuckle. Unlike the
         health-check abstractions this one is not in the shared framework, so it needs a version.
         Pinned to 10.0.11, not 10.0.0 to match the packages above: 10.0.0 resolves a transitive
         Microsoft.OpenApi 2.0.0, which carries a known high-severity advisory
         (GHSA-v5pm-xwqc-g5wc). 10.0.11 resolves 2.7.5 and clears it without pinning the
         transitive directly. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />

    <!-- Edge routing (ADR-0002: YARP is the API gateway). Only Gateway.Api references this; the
         BFF proxies via typed HttpClients, not a reverse proxy. -->
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />

    <!-- Identity/auth (014-identity-server-auth; ADR-0001: Duende IdentityServer is the identity
         server product; constitution Principle VI). Unlike Cookies/Negotiate, JwtBearer is not part
         of the Microsoft.AspNetCore.App shared framework — it needs its own package reference.
         Only shared/Identity references this; every service consumes it through
         AddIdentityValidation() rather than referencing JwtBearer directly (research.md Decision 4). -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <!-- The identity server itself (services/identity only). 8.0.6 is Duende's first line to target
         net10.0 directly (verified against the published .nuspec, matching the platform's TFM);
         all three ship in lockstep from the same repo, hence the shared version. No license key is
         configured yet — ADR-0001 Action Item 1 ("procure a license appropriate to current revenue
         tier") is still open; Duende runs in its unlicensed/trial mode (a startup log warning, not
         a hard failure) until that is done. -->
    <PackageVersion Include="Duende.IdentityServer" Version="8.0.6" />
    <PackageVersion Include="Duende.IdentityServer.EntityFramework" Version="8.0.6" />
    <PackageVersion Include="Duende.IdentityServer.AspNetIdentity" Version="8.0.6" />
    <!-- ASP.NET Core Identity's own EF Core store (services/identity's user/credential store —
         research.md Decision 8). Not in the shared framework; matches the 10.0.11 pin already used
         for Microsoft.AspNetCore.OpenApi above for the same transitive-advisory reason. -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />

    <!-- Resilience (constitution Principle VIII; 002-gateway-bff-routing research.md Decision 3).
         Supplies AddStandardResilienceHandler() — the timeout/retry/circuit-breaker pipeline every
         outbound BFF call must be wrapped in, so no unbounded wait can exist. -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />

    <!-- Testing (research.md Decision 2: xUnit; constitution Principle III: Testcontainers, no fakes).
         Versions match what `dotnet new xunit` on the installed .NET 10 SDK resolves as current. -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <!-- Consumer-driven contract testing (ADR-0006; 011-consumer-contract-tests research.md
         Decision 1). Referenced only by the *.Api.ContractTests projects: it ships both the
         HTTP-pact DSL the BFF-facing boundaries use and the message-pact DSL the BasketCheckedOut
         event pilot uses, so no service's runtime code ever takes a dependency on it. -->
    <PackageVersion Include="PactNet" Version="5.0.1" />
    <!-- 4.0.0 pulls in SSH.NET 2023.0.0, which carries a known high-severity advisory
         (GHSA-q939-rpr3-3284). Bumping Testcontainers.MsSql and pinning SSH.NET directly
         so the patched version wins regardless of what the transitive minimum declares. -->
    <PackageVersion Include="Testcontainers.MsSql" Version="4.14.0" />
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <!-- 010-testcontainers-integration-tests: Redis and RabbitMQ Testcontainers fixtures.
         All Testcontainers.* packages ship in lockstep from the same repo, so these are pinned to
         the same 4.14.0 already used by Testcontainers.MsSql above (research.md Decision 1). -->
    <PackageVersion Include="Testcontainers.Redis" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.14.0" />
    <!-- Smoke-test clients for the fixtures above, referenced only by
         shared/IntegrationTestSupport.Tests — never by a service's runtime code (research.md
         Decision 2; spec.md FR-009: no production caching/messaging dependency is introduced). -->
    <PackageVersion Include="StackExchange.Redis" Version="3.1.31" />
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />

    <!-- JSON Schema 2020-12 validation, test-only. Referenced solely by
         shared/EventContracts.UnitTests to prove a serialized event instance satisfies its
         published schema (008-versioned-event-schemas research.md Decision 2). It is deliberately
         NOT referenced by shared/EventContracts itself: runtime schema validation is not part of
         this platform's safety net (ADR-0005), so no service ever takes a dependency on it. -->
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />
  </ItemGroup>

</Project>
