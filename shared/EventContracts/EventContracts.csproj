<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Deliberately no PackageReference and no FrameworkReference. Unlike Tenancy and
       ServiceDefaults, this library defines plain data contracts, not middleware, so it needs
       neither ASP.NET Core types nor a schema validator: runtime schema validation is explicitly
       not part of this platform's safety net (ADR-0005). The only validator in play is a
       test-time one, referenced by EventContracts.UnitTests. -->

  <!-- The schema documents ship inside the assembly, not merely beside it, so anything that needs
       to read one (the tests today, a future publisher validating in a diagnostic mode) loads it
       via Assembly.GetManifestResourceStream instead of guessing at a working directory. -->
  <ItemGroup>
    <EmbeddedResource Include="schemas/*.json">
      <!-- Pin the manifest name to the bare file name so a reader asks for
           "OrderPlaced.v1.schema.json", not a root-namespace-and-folder-derived string that would
           silently change if the project or folder were ever renamed. -->
      <LogicalName>%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
