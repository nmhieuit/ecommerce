{
  "consumer": {
    "name": "bff"
  },
  "interactions": [
    {
      "description": "a request for the catalog",
      "providerStates": [
        {
          "name": "the catalog contains at least one product"
        }
      ],
      "request": {
        "headers": {
          "X-Tenant-Id": "contoso"
        },
        "method": "GET",
        "path": "/products"
      },
      "response": {
        "body": [
          {
            "id": "9f8d6b1e-0001-4000-8000-000000000001",
            "name": "Field Notes Notebook",
            "price": 12.5
          }
        ],
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].price": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.4.27",
      "models": "1.2.8"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "products"
  }
}