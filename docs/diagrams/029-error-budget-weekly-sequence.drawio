    <diagram id="error-budget-weekly-sequence" name="Trình tự thật — đốt ngân sách 5xx tuần của cả 7 service bằng folder Postman 29, cảnh báo bật đúng mốc">
        <mxGraphModel dx="1500" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" parent="1" style="text;html=1;fontStyle=1;fontSize=14;fontColor=#333333;" value="Trình tự thật (T027, T032 — 2026-10-05) — đốt ngân sách 5xx tuần của 7 service bằng tiêm lỗi có kiểm soát" vertex="1">
                    <mxGeometry height="26" width="1380" x="30" y="10" as="geometry"/>
                </mxCell>
                <mxCell id="c1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" value="Người vận hành&#xa;(newman, folder 29)" vertex="1">
                    <mxGeometry height="50" width="180" x="30" y="60" as="geometry"/>
                </mxCell>
                <mxCell id="c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" value="7 service&#xa;(ChaosFaultInjectionMiddleware)" vertex="1">
