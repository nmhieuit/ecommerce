<mxfile host="Electron" agent="5.0">
  <diagram id="quality-gate-flow-nghiep-vu" name="Vòng đời một yêu cầu thay đổi">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" style="text;html=1;fontStyle=1;fontSize=16;fontColor=#333333;" value="Vòng đời một yêu cầu thay đổi mã nguồn — từ lúc đề xuất tới lúc được chấp nhận" vertex="1">
          <mxGeometry height="30" width="1100" x="30" y="20" as="geometry" />
        </mxCell>

        <mxCell id="n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="1. Một người trong đội đề xuất một thay đổi&#xa;(mở &quot;yêu cầu thay đổi&quot;)" vertex="1">
          <mxGeometry height="80" width="220" x="30" y="90" as="geometry" />
        </mxCell>

        <mxCell id="n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" value="2. Hệ thống TỰ ĐỘNG kiểm tra&#xa;(không ai phải nhớ bấm nút)&#xa;— 5 vòng kiểm tra liên tiếp, gồm cả&#xa;kiểm tra chất lượng mã nguồn" vertex="1">
          <mxGeometry height="100" width="240" x="310" y="80" as="geometry" />
        </mxCell>

        <mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="Đạt tất cả&#xa;kiểm tra?" vertex="1">
          <mxGeometry height="110" width="150" x="610" y="75" as="geometry" />
        </mxCell>

        <mxCell id="n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="4a. Được phép gộp vào&#xa;hệ thống chính&#xa;(merge)" vertex="1">
          <mxGeometry height="80" width="220" x="850" y="20" as="geometry" />
        </mxCell>

        <mxCell id="n4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" value="4b. Bị chặn ngay lập tức&#xa;— hiển thị rõ lý do tại chỗ&#xa;(không cần đi tìm ở đâu khác)" vertex="1">
          <mxGeometry height="90" width="230" x="850" y="150" as="geometry" />
        </mxCell>

        <mxCell id="n5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontColor=#7a1f1f;" value="Không ai gộp được lúc này —&#xa;kể cả người có quyền quản trị&#xa;cao nhất trong hệ thống" vertex="1">
          <mxGeometry height="70" width="230" x="850" y="260" as="geometry" />
        </mxCell>

        <mxCell id="n6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="5. Người đề xuất sửa lại&#xa;vấn đề được chỉ ra" vertex="1">
          <mxGeometry height="70" width="230" x="850" y="360" as="geometry" />
        </mxCell>

        <mxCell id="note1" parent="1" style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;" value="Chỉ số chất lượng (mức độ được kiểm thử, mức trùng lặp, số vấn đề mới phát hiện) hiển thị NGAY tại yêu&#xa;cầu thay đổi đó — không cần rời trang, không cần đăng nhập vào công cụ đo lường riêng để tra cứu." vertex="1">
          <mxGeometry height="40" width="470" x="310" y="200" as="geometry" />
        </mxCell>

        <mxCell id="note2" parent="1" style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;" value="Sau khi sửa và gửi lại, quay về bước 2 — HOÀN TOÀN TỰ ĐỘNG, không cần ai&#xa;bấm nút &quot;kiểm tra lại&quot;. Nếu lần này đạt, được mở khoá ngay trong đúng một lượt." vertex="1">
          <mxGeometry height="40" width="470" x="310" y="500" as="geometry" />
        </mxCell>

        <mxCell id="e1" edge="1" parent="1" source="n1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" target="n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="n2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="d1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;fontColor=#2d6a2d;" target="n3" value="Có">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="d1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;fontColor=#b85450;" target="n4" value="Không">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="n4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;dashed=1;" target="n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="n5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" target="n6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="n6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="n2" value="Tự động kiểm tra lại từ đầu">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="430" y="395" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
