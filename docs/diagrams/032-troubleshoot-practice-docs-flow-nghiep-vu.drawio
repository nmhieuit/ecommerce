<mxfile host="65bd71144e">
    <diagram id="troubleshoot-practice-docs-flow-nghiep-vu" name="Luồng nghiệp vụ — luyện troubleshoot: làm theo hướng dẫn hoặc đọc gợi ý mở dần, rồi khôi phục và tự đánh giá">
        <mxGraphModel dx="1443" dy="468" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="620" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" parent="1" style="text;html=1;fontStyle=1;fontSize=14;fontColor=#333333;" value="Luồng nghiệp vụ — chọn cách luyện, tìm nguyên nhân theo hướng dẫn hoặc gợi ý mở dần, khôi phục, xác nhận ổn định 15 phút, tự đánh giá" vertex="1">
                    <mxGeometry height="26" width="1390" x="30" y="10" as="geometry"/>
                </mxCell>
                <mxCell id="f1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" value="1. Chọn cách luyện:&#xa;biết trước nhóm lỗi (có kịch bản)&#xa;hoặc lỗi bất ngờ không báo trước" vertex="1">
                    <mxGeometry height="80" width="240" x="30" y="230" as="geometry"/>
                </mxCell>
                <mxCell id="f2a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=6;" value="2a. Có kịch bản: gây lỗi theo nhóm,&#xa;mở file hướng dẫn của nhóm đó và&#xa;làm theo từng bước (nơi nhìn, truy vấn đối chiếu)" vertex="1">
                    <mxGeometry height="90" width="300" x="310" y="70" as="geometry"/>
                </mxCell>
                <mxCell id="f2b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;" value="2b. Bất ngờ: hệ thống bốc thăm một nhóm;&#xa;người học thấy triệu chứng (5xx, trễ, 401,&#xa;mất traffic…) và tra file gợi ý theo triệu chứng" vertex="1">
                    <mxGeometry height="90" width="300" x="310" y="380" as="geometry"/>
                </mxCell>
                <mxCell id="f3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" value="3. Tìm nguyên nhân bằng&#xa;dashboard, truy vấn và log;&#xa;nêu nhóm lỗi và bộ phận bị lỗi" vertex="1">
                    <mxGeometry height="90" width="260" x="660" y="225" as="geometry"/>
                </mxCell>
                <mxCell id="d1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=6;fontStyle=1;" value="Bế tắc?" vertex="1">
                    <mxGeometry height="60" width="140" x="660" y="380" as="geometry"/>
                </mxCell>
                <mxCell id="f4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" value="Mở gợi ý từng mức:&#xa;1 triệu chứng + cách kiểm&#xa;2 nhóm lỗi · 3 đáp án&#xa;(tài liệu hoặc lệnh -Hint)" vertex="1">
                    <mxGeometry height="90" width="260" x="660" y="480" as="geometry"/>
                </mxCell>
                <mxCell id="f5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" value="4. Khôi phục bằng một lệnh,&#xa;chờ bộ phận bị lỗi khoẻ lại" vertex="1">
                    <mxGeometry height="80" width="220" x="970" y="225" as="geometry"/>
                </mxCell>
                <mxCell id="f6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" value="5. Xác nhận: 15 phút liên tục đạt SLO&#xa;và không còn cảnh báo (truy vấn ở file 08)" vertex="1">
                    <mxGeometry height="70" width="300" x="970" y="340" as="geometry"/>
                </mxCell>
                <mxCell id="f7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" value="6. Bài tập tự làm và checklist&#xa;&quot;đã đạt&quot; của nhóm; với bài mù:&#xa;mở niêm phong, đối chiếu đáp án" vertex="1">
                    <mxGeometry height="90" width="300" x="970" y="450" as="geometry"/>
                </mxCell>
                <mxCell id="f8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;dashed=1;" value="Quy trình triage và bản ghi sự cố&#xa;(diễn tập on-call) — chỉ liên kết" vertex="1">
                    <mxGeometry height="70" width="240" x="1180" y="70" as="geometry"/>
                </mxCell>
                <mxCell id="note" parent="1" style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;fontStyle=2;" value="Dạng có kịch bản làm theo file 09–16, mỗi nhóm một file. Dạng bất ngờ dùng file 17 (3 mức, cùng nghĩa với lệnh -Hint nhưng có chỉ dẫn cách kiểm). Lỗi luyện tính vào ngân sách lỗi tuần như sự cố thật." vertex="1">
                    <mxGeometry height="40" width="900" x="30" y="580" as="geometry"/>
                </mxCell>
