<mxfile host="65bd71144e">
    <diagram id="troubleshoot-practice-docs-flow-nghiep-vu" name="Luồng nghiệp vụ — luyện troubleshoot: làm theo hướng dẫn hoặc đọc gợi ý mở dần, rồi khôi phục và tự đánh giá">
        <mxGraphModel dx="976" dy="333" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="620" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Luồng nghiệp vụ — chọn cách luyện, tìm nguyên nhân theo hướng dẫn hoặc gợi ý mở dần, khôi phục, xác nhận ổn định 15 phút, tự đánh giá" style="text;html=1;fontStyle=1;fontSize=14;fontColor=#333333;" parent="1" vertex="1"><mxGeometry x="30" y="10" width="1390" height="26" as="geometry"/></mxCell>
                <mxCell id="f1" value="1. Chọn cách luyện:&#xa;biết trước nhóm lỗi (có kịch bản)&#xa;hoặc lỗi bất ngờ không báo trước" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="30" y="230" width="240" height="80" as="geometry"/></mxCell>
                <mxCell id="f2a" value="2a. Có kịch bản: gây lỗi theo nhóm,&#xa;mở file hướng dẫn của nhóm đó và&#xa;làm theo từng bước (nơi nhìn, truy vấn đối chiếu)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="310" y="70" width="300" height="90" as="geometry"/></mxCell>
                <mxCell id="f2b" value="2b. Bất ngờ: hệ thống bốc thăm một nhóm;&#xa;người học thấy triệu chứng (5xx, trễ, 401,&#xa;mất traffic…) và tra file gợi ý theo triệu chứng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="310" y="380" width="300" height="90" as="geometry"/></mxCell>
                <mxCell id="f3" value="3. Tìm nguyên nhân bằng&#xa;dashboard, truy vấn và log;&#xa;nêu nhóm lỗi và bộ phận bị lỗi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="660" y="225" width="260" height="90" as="geometry"/></mxCell>
                <mxCell id="d1" value="Bế tắc?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=6;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="660" y="380" width="140" height="60" as="geometry"/></mxCell>
                <mxCell id="f4" value="Mở gợi ý từng mức:&#xa;1 triệu chứng + cách kiểm&#xa;2 nhóm lỗi · 3 đáp án&#xa;(tài liệu hoặc lệnh -Hint)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="660" y="480" width="260" height="90" as="geometry"/></mxCell>
                <mxCell id="f5" value="4. Khôi phục bằng một lệnh,&#xa;chờ bộ phận bị lỗi khoẻ lại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="970" y="225" width="220" height="80" as="geometry"/></mxCell>
                <mxCell id="f6" value="5. Xác nhận: 15 phút liên tục đạt SLO&#xa;và không còn cảnh báo (truy vấn ở file 08)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="970" y="340" width="300" height="70" as="geometry"/></mxCell>
                <mxCell id="f7" value="6. Bài tập tự làm và checklist&#xa;&quot;đã đạt&quot; của nhóm; với bài mù:&#xa;mở niêm phong, đối chiếu đáp án" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="970" y="450" width="300" height="90" as="geometry"/></mxCell>
                <mxCell id="f8" value="Quy trình triage và bản ghi sự cố&#xa;(diễn tập on-call) — chỉ liên kết" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;dashed=1;" parent="1" vertex="1"><mxGeometry x="1180" y="70" width="240" height="70" as="geometry"/></mxCell>
                <mxCell id="note" value="Dạng có kịch bản làm theo file 09–16, mỗi nhóm một file. Dạng bất ngờ dùng file 17 (3 mức, cùng nghĩa với lệnh -Hint nhưng có chỉ dẫn cách kiểm). Lỗi luyện tính vào ngân sách lỗi tuần như sự cố thật." style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;fontStyle=2;" parent="1" vertex="1"><mxGeometry x="30" y="560" width="900" height="40" as="geometry"/></mxCell>
                <mxCell id="e1" value="có kịch bản" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="f1" target="f2a" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="e2" value="bất ngờ" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="f1" target="f2b" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="f2a" target="f3" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="f2b" target="f3" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="f3" target="d1" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="e6" value="có" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="d1" target="f4" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="e7" value="đã biết" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;dashed=1;" parent="1" source="f4" target="f3" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="e8" value="đã tìm ra" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="f3" target="f5" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="f5" target="f6" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="f6" target="f7" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="e11" value="tham khảo" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;dashed=1;" parent="1" source="f3" target="f8" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
