                <mxCell id="c3" value="Products.Api" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="630" y="60" width="200" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="r1" value="TRƯỚC (khoảng hở #6/#7): GET /bff/basket/{id}&#xa;→ BFF gọi GetProductsAsync() KHÔNG tham số" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="30" y="130" width="500" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r2" value="Products.Api trả về TOÀN BỘ catalog&#xa;(ví dụ 500 sản phẩm) chỉ để join tên 5 dòng trong giỏ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="630" y="190" width="400" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r3" value="SAU (Decision 4): GET /bff/basket/{id}&#xa;→ BFF gọi GetProductsByIdsAsync([5 id trong giỏ])" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="30" y="260" width="500" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r4" value="Products.Api: GET /products?ids=... → đúng 1 lời gọi HTTP&#xa;trả về đúng 5 sản phẩm khớp, bất kể catalog lớn cỡ nào" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="630" y="320" width="400" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r5" value="Client: GET /products?pageSize=1000000&#xa;(cố tình khai kích thước trang cực lớn)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="30" y="400" width="500" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r6" value="Math.Clamp(pageSize, 1, MaxPageSize=100)&#xa;→ trả về đúng 100 bản ghi, không phản ánh 1000000 client yêu cầu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1">
