<mxfile host="65bd71144e">
    <diagram id="audit-n1-unbounded-pagination-sequence" name="Trình tự — trước/sau khi sửa over-fetch và ép trần phân trang">
        <mxGraphModel dx="1499" dy="527" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="700" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
