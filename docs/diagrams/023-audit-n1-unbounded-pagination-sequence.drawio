                </mxCell>
                <mxCell id="c2" value="Bff.Api" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="330" y="60" width="160" height="40" as="geometry"/>
