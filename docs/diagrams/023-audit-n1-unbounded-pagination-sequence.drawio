                <mxCell id="title" value="Trình tự: render basket 5 dòng (trước/sau) + ép trần pageSize" style="text;html=1;fontStyle=1;fontSize=14;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="30" y="10" width="900" height="26" as="geometry"/>
                </mxCell>
