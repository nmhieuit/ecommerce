<mxfile host="65bd71144e">
    <diagram id="verify-transactional-outbox-sequence" name="Trình tự thật — 2-host mô phỏng crash giữa commit và publish">
        <mxGraphModel dx="1499" dy="527" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="700" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Kịch bản 2-host (Quyết định 4) — sống sót qua crash tiến trình" style="text;html=1;fontStyle=1;fontSize=14;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="30" y="10" width="900" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="c1" value="Host A&#xa;(tiến trình trước khi sập)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="60" width="220" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="c2" value="SQL Server + RabbitMQ&#xa;(Testcontainers, dùng chung)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="580" y="60" width="240" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="c3" value="Host B&#xa;(tiến trình khởi động lại)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1120" y="60" width="220" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r1" value="1. POST /orders qua HttpClient của Host A&#xa;(QueryDelay cấu hình DÀI hơn bước gọi API)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="30" y="140" width="500" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r2" value="2. Transaction commit: Order + OutboxMessage&#xa;cùng tồn tại thật trong CSDL (201 trả về)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="580" y="200" width="400" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r3" value="3. Host A.Dispose() NGAY — mô phỏng tiến trình sập&#xa;TRƯỚC KHI outbox delivery service kịp gửi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="30" y="270" width="500" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r4" value="4. Host B khởi tạo mới, trỏ CÙNG connection string&#xa;+ cùng RabbitMQ container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="1120" y="340" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="r5" value="5. Outbox delivery service của Host B tự quét,&#xa;thấy bản ghi outbox cũ CHƯA gửi (do Host A để lại)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="580" y="420" width="400" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r6" value="6. OrderPlacedV1 được gửi ra RabbitMQ thật —&#xa;không cần gọi API nào khác, không can thiệp thủ công" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="1120" y="480" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="r7" value="7. Consumer xác minh (chạy trên Host B) nhận đúng sự kiện đó —&#xa;xác nhận &quot;at-least-once&quot; sống sót qua vòng đời tiến trình" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="30" y="560" width="900" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="c1" target="r1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="r1" target="r2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="r2" target="r3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="r3" target="r4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="r4" target="r5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="r5" target="r6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="r6" target="r7" edge="1">
