<mxfile host="65bd71144e">
    <diagram id="quality-gate-flow-nghiep-vu" name="Vòng đời một yêu cầu thay đổi">
        <mxGraphModel dx="1232" dy="448" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Vòng đời một yêu cầu thay đổi mã nguồn — từ lúc đề xuất tới lúc được chấp nhận" style="text;html=1;fontStyle=1;fontSize=16;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="30" y="20" width="1100" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="n1" value="1. Một người trong đội đề xuất một thay đổi&#xa;(mở &quot;yêu cầu thay đổi&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="90" width="220" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="n2" value="2. Hệ thống TỰ ĐỘNG kiểm tra&#xa;(không ai phải nhớ bấm nút)&#xa;— 5 vòng kiểm tra liên tiếp, gồm cả&#xa;kiểm tra chất lượng mã nguồn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="310" y="80" width="240" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="d1" value="Đạt tất cả&#xa;kiểm tra?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="610" y="75" width="150" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="n3" value="4a. Được phép gộp vào&#xa;hệ thống chính&#xa;(merge)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="850" y="20" width="220" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="n4" value="4b. Bị chặn ngay lập tức&#xa;— hiển thị rõ lý do tại chỗ&#xa;(không cần đi tìm ở đâu khác)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="850" y="150" width="230" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="n5" value="Không ai gộp được lúc này —&#xa;kể cả người có quyền quản trị&#xa;cao nhất trong hệ thống" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontColor=#7a1f1f;" parent="1" vertex="1">
                    <mxGeometry x="850" y="260" width="230" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="n6" value="5. Người đề xuất sửa lại&#xa;vấn đề được chỉ ra" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="850" y="360" width="230" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="note1" value="Chỉ số chất lượng (mức độ được kiểm thử, mức trùng lặp, số vấn đề mới phát hiện) hiển thị NGAY tại yêu&#xa;cầu thay đổi đó — không cần rời trang, không cần đăng nhập vào công cụ đo lường riêng để tra cứu." style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;" parent="1" vertex="1">
                    <mxGeometry x="290" y="200" width="490" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="note2" value="Sau khi sửa và gửi lại, quay về bước 2 — HOÀN TOÀN TỰ ĐỘNG, không cần ai&#xa;bấm nút &quot;kiểm tra lại&quot;. Nếu lần này đạt, được mở khoá ngay trong đúng một lượt." style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;" parent="1" vertex="1">
                    <mxGeometry x="310" y="500" width="470" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" parent="1" source="n1" target="n2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" parent="1" source="n2" target="d1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" value="Có" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;fontColor=#2d6a2d;" parent="1" source="d1" target="n3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4" value="Không" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;fontColor=#b85450;" parent="1" source="d1" target="n4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;dashed=1;" parent="1" source="n4" target="n5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" parent="1" source="n5" target="n6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e7" value="Tự động kiểm tra lại từ đầu" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;exitX=0;exitY=0.5;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" parent="1" source="n6" target="n2" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="490" y="395"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
            </root>
        </mxGraphModel>
