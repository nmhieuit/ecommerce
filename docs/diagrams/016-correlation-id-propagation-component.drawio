    <diagram id="correlation-id-propagation-component" name="Kiến trúc thành phần — mã theo dõi lan truyền từ edge tới frontend">
        <mxGraphModel dx="1499" dy="527" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="850" math="0" shadow="0">
            <root>
