                <mxCell id="b1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=6;" value="2. Rule 027/028 (chu kỳ 5 phút) chạy với điều kiện loại /health*&#xa;span health chậm không vào mẫu số" vertex="1"><mxGeometry height="70" width="380" x="30" y="170" as="geometry"/></mxCell>
