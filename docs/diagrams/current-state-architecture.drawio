        <mxCell id="gwnote" parent="1" style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;" value="Vi sao 1 route catch-all: neu Gateway phai liet ke tung duong dan cua BFF thi&#xa;moi lan BFF them tinh nang lai phai sua + deploy Gateway. Do chinh la su rang buoc&#xa;ma tinh nang nay sinh ra de xoa bo.&#xa;&#xa;Gateway CO TINH khong co duong di thang toi service nghiep vu nao&#xa;(co bai test canh dieu nay)." vertex="1">
          <mxGeometry height="105" width="500" x="490" y="155" as="geometry" />
        </mxCell>
        <mxCell id="bff" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="Bff.Api (services/bff) -- Backend For Frontend&#xa;Cong 5301  |  KHONG co co so du lieu&#xa;GET /bff/products, /bff/baskets/{id},&#xa;      /bff/orders/{id}, /bff/parties/{id}&#xa;Sinh tu dong tai lieu API tai /openapi/v1.json" vertex="1">
          <mxGeometry height="120" width="430" x="30" y="290" as="geometry" />
        </mxCell>
        <mxCell id="bffnote" parent="1" style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;" value="Ngan sach thoi gian cho MOI loi goi ra ngoai (khong cho vo han):&#xa;   1 giay / lan thu   |   toi da 3 giay ke ca thu lai   |   cau dao ngat khi service kia da chet&#xa;&#xa;Phan biet loai loi tra ve nguoi dung:&#xa;   502 = service kia BIEN MAT      504 = service kia DANG DUOI&#xa;   500 = loi cua chinh BFF          404 = khong tim thay ban ghi (KHONG phai loi)&#xa;&#xa;Du lieu duoc CAT GOT lai truoc khi ra ngoai: truong noi bo (vd gia von) khong tu dong&#xa;lot ra trinh duyet khi service phia sau them truong moi." vertex="1">
          <mxGeometry height="140" width="900" x="490" y="270" as="geometry" />
        </mxCell>
