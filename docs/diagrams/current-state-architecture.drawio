        <mxCell id="title1" parent="1" style="text;html=1;fontStyle=1;fontSize=15;fontColor=#2d6a2d;" value="PHAN 1 -- DA CO TRONG CODE HOM NAY (24 du an .NET + 1 workspace frontend; 1 LENH DUY NHAT chay toan bo stack)" vertex="1">
