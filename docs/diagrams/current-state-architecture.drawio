        <mxCell id="client" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" value="Nguoi goi (curl / Postman)&#xa;SPA React: CHUA CO CODE (xem specs/004, con la spec)&#xa;CHI biet DUY NHAT dia chi cong 5300&#xa;Chua dang nhap that -- Gateway tu dong gan 1 danh tinh gia lap" vertex="1">
