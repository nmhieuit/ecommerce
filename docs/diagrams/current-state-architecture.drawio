        <mxCell id="guard1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" value="tests/CrossServiceIsolation.Tests&#xa;- Service A cam chuoi ket noi CSDL cua service B&#xa;- Gateway/BFF cam BAT KY chuoi ket noi nao (khong so huu du lieu)&#xa;- Moi service phai co DUNG 1 diem khoi tao DbContext,&#xa;  va diem do phai goi RequireTenantId()" vertex="1">
