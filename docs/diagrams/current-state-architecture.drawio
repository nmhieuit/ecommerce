        <mxCell id="gw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="Gateway.Api (services/gateway) -- YARP&#xa;Cong 5300&#xa;Bang route = 1 dong duy nhat: MOI duong dan -&gt; BFF&#xa;Toan bo dinh tuyen nam trong file cau hinh JSON,&#xa;khong co logic trong code C#" vertex="1">
