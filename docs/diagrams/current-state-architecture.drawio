        <mxCell id="guard5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" value="services/*/tests/*.IntegrationTests -- Testcontainers.MsSql:&#xa;chay SQL Server THAT trong container, khong dung gia lap.&#xa;Test cua BFF con chay ca 4 service THAT trong bo nho de&#xa;kiem tra that su goi duoc, thay vi gia lap cau tra loi." vertex="1">
