        <mxCell id="guard3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" value="Gateway.Api.UnitTests / IntegrationTests&#xa;- RouteConfigurationTests: cau hinh dinh tuyen sai, hoac co&#xa;  route di thang toi service nghiep vu&#xa;- ForwardingTimeoutBudgetTests: timeout Gateway (10s) &lt; 3s BFF&#xa;- MOI: StorefrontCorsTests -- chi web SPA duoc goi qua CORS" vertex="1">
