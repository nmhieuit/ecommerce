        <mxCell id="tenancy" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="shared/Tenancy&#xa;(thu vien dung chung, KHONG phai service, MOI tu 003)&#xa;- TenantContext.RequireTenantId(): chan MOI ket noi&#xa;  CSDL neu tenant chua duoc xac dinh&#xa;- Header lan truyen: X-Tenant-Id" vertex="1">
          <mxGeometry height="100" width="260" x="1160" y="50" as="geometry" />
        </mxCell>
        <mxCell id="gw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="Gateway.Api (services/gateway) -- YARP&#xa;Cong 5300&#xa;Bang route = 1 dong duy nhat: MOI duong dan -&gt; BFF&#xa;StubIdentity: xac thuc LUON thanh cong, gan co dinh&#xa;tenant &quot;contoso&quot; + nguoi dung gia lap, ghi de X-Tenant-Id&#xa;(khong tin gia tri tu ngoai gui vao)" vertex="1">
          <mxGeometry height="140" width="460" x="30" y="175" as="geometry" />
        </mxCell>
        <mxCell id="gwnote" parent="1" style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;" value="Vi sao 1 route catch-all: neu Gateway phai liet ke tung duong dan cua BFF thi&#xa;moi lan BFF them tinh nang lai phai sua + deploy Gateway.&#xa;&#xa;Gateway CO TINH khong co duong di thang toi service nghiep vu nao&#xa;(co bai test canh dieu nay).&#xa;&#xa;StubIdentity la &quot;cam tam&quot; thay cho Identity Server that (SCRUM-23, Giai&#xa;doan 3) -- hom nay MOI request deu duoc xac thuc thanh cong." vertex="1">
          <mxGeometry height="140" width="650" x="510" y="175" as="geometry" />
        </mxCell>
        <mxCell id="bff" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="Bff.Api (services/bff) -- Backend For Frontend&#xa;Cong 5301  |  KHONG co co so du lieu&#xa;GET /bff/products, /bff/baskets/{id},&#xa;      /bff/orders/{id}, /bff/parties/{id}&#xa;TenantPropagationHandler: gan lai X-Tenant-Id len ca 4&#xa;loi goi ra ngoai (HttpClient khong tu chuyen tiep header)" vertex="1">
          <mxGeometry height="140" width="460" x="30" y="335" as="geometry" />
        </mxCell>
        <mxCell id="bffnote" parent="1" style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;" value="Ngan sach thoi gian cho MOI loi goi ra ngoai (khong cho vo han):&#xa;   1 giay / lan thu (toi da 2 lan thu lai)  |  toi da 3 giay tong cong  |  cau dao ngat sau 10s loi lien tuc&#xa;&#xa;Phan biet loai loi tra ve nguoi dung:&#xa;   502 = downstream khong ket noi duoc / cau dao da ngat        504 = downstream vuot thoi gian cho&#xa;   500 = loi cua chinh BFF (khong phai downstream)                404 = khong tim thay ban ghi (KHONG phai loi)&#xa;&#xa;Du lieu duoc CAT GOT lai truoc khi ra ngoai qua ham anh xa rieng (vd ToSummary): truong noi bo&#xa;khong tu dong lot ra ngoai khi service phia sau them truong moi." vertex="1">
          <mxGeometry height="160" width="890" x="514" y="322" as="geometry" />
        </mxCell>
        <mxCell id="svcnote" parent="1" style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;" value="4 service nghiep vu HOAN TOAN khong biet den nhau: khong cai nao goi cai nao, khong cai nao tham chieu code cua cai nao." vertex="1">
