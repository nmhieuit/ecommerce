        <mxCell id="svc1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="Products.Api&#xa;Cong 5088&#xa;GET /products -- HIEN LUON TRA VE RONG (chua co du lieu mau)&#xa;+ /health/live, /health/ready&#xa;Bang: Product (Id, Name, Price)&#xa;Chan doc/ghi CSDL neu thieu X-Tenant-Id (RequireTenantId)" vertex="1">
