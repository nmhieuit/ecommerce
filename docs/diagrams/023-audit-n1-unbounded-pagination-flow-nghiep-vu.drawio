                <mxCell id="s4" value="Hệ thống ổn định, nhanh, không phụ thuộc&#xa;vào việc dữ liệu lớn tới đâu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="890" y="220" width="360" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="s5" value="Song song: nếu ai cố ý khai 1 số lượng cực lớn,&#xa;hoặc quên đặt giới hạn khi thêm tính năng mới —&#xa;hệ thống tự chặn/tự nhắc, không cần nhớ thủ công" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1">
