    <diagram id="audit-n1-unbounded-pagination-flow" name="Luồng nghiệp vụ — không còn truy vấn lấy hết dữ liệu">
        <mxGraphModel dx="1499" dy="527" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="600" math="0" shadow="0">
            <root>
