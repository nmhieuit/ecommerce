                <mxCell id="s3" value="Nay: mọi danh sách tự động giới hạn kích thước,&#xa;giỏ hàng chỉ lấy đúng sản phẩm cần thiết" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" parent="1" vertex="1">
