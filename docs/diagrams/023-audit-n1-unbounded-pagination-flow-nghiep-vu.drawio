                <mxCell id="s2" value="Trước đây: 1 lời gọi đơn giản có thể&#xa;kéo về TOÀN BỘ dữ liệu, làm chậm hệ thống" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="460" y="80" width="380" height="70" as="geometry"/>
