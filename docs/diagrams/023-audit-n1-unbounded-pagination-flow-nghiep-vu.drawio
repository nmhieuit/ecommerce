                </mxCell>
                <mxCell id="s1" value="Dữ liệu tăng trưởng theo thời gian&#xa;(nhiều sản phẩm, nhiều dòng trong giỏ hàng)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="30" y="80" width="380" height="70" as="geometry"/>
