<mxfile host="65bd71144e">
    <diagram id="incident-oncall-drill-sequence" name="Trình tự thật (T025, T030 — 2026-10-02) — tiêm đích sai vào orders-api, phát hiện, khôi phục, xác nhận 15 phút">
        <mxGraphModel dx="976" dy="333" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="780" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Trình tự thật (T025, T030 — 2026-10-02, chế độ không mù) — đích kết nối sai trên orders-api" style="text;html=1;fontStyle=1;fontSize=14;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="30" y="10" width="1380" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="c1" value="Người vận hành" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="30" y="60" width="180" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="c2" value="incident-drill.ps1 (+ -Load)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="270" y="60" width="220" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="c3" value="7 container (Docker Compose)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="550" y="60" width="250" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="c4" value="Elasticsearch + rule incident-fast-detection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="860" y="60" width="250" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="c5" value="Dashboard + Kibana Case" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1170" y="60" width="220" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r1" value="1. Thêm CHAOS_ALLOW_FAULT_INJECTION=true vào .env;&#xa;-Start -Service orders-api -FaultType A -DelaySeconds 0 → runId + SHA-256" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="30" y="140" width="520" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r2" value="2. 11:00:25 — tạo lại 7 container; orders-api nhận Server=incident-missing-db" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="270" y="210" width="560" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="r3" value="3. 11:02:00 — lần chạy rule đầu: alert cho cả 7 service (khởi động nguội)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="550" y="270" width="560" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="r4" value="4. 11:07–11:17 — Orders.Api giữ alert; Bff.Api 22,5% và Gateway.Api 31,9% 5xx (lan theo chuỗi);&#xa;parties/products/baskets/identity chậm từng đợt (p95 320–560 ms, không 5xx)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="550" y="330" width="620" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r5" value="5. Bảng &quot;Phát hiện nhanh&quot; hiện service; Case [SEV2] severity high, tag incident-drill/sev2, comment mốc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="860" y="400" width="540" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r6" value="6. ~11:27 — bỏ cờ khỏi .env, chạy lại compose → 7 container cấu hình đúng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="30" y="470" width="560" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="r7" value="7. 11:32:03 — alert Orders.Api recovered" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="550" y="530" width="420" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="r8" value="8. Truy vấn theo phút: 11:46–11:59 chỉ 14 phút (12:00 p95 167 ms) → chuỗi 12:01–12:15 → mốc giải quyết 12:15" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="30" y="590" width="800" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="r9" value="9. -Reveal → mã băm khớp; đối chiếu lựa chọn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="30" y="650" width="460" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="note" value="Lỗi của script bắt được trên đường: -Load thoát lúc 11:00 vì taskkill ghi stderr (đã sửa); token hỏng sau khi tạo lại identity → BFF 502/504 (đã sửa: lấy token lại khi identity đổi Id)." style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;fontStyle=2;" parent="1" vertex="1">
