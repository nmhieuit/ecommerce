<mxfile host="65bd71144e">
    <diagram id="error-budget-alerting-component" name="Kiến trúc thành phần — chính sách ngân sách lỗi, 4 rule ES|QL, 3 panel trên dashboard SLO">
        <mxGraphModel dx="2906" dy="427" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" parent="1" style="text;html=1;fontStyle=1;fontSize=14;fontColor=#333333;" value="Kiến trúc thành phần — chính sách trong manifest, đo và cảnh báo bằng 4 rule Kibana ES|QL, nhìn thấy trên dashboard SLO hằng ngày" vertex="1">
                    <mxGeometry height="26" width="1420" x="30" y="10" as="geometry"/>
                </mxCell>
                <mxCell id="manifests" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" value="7× service-manifest.yaml&#xa;(parties, products, baskets, orders, identity, gateway, bff)&#xa;slos: {latency.p95, latency.p99, error-rate, availability}  ← nguồn ngưỡng duy nhất&#xa;error-budget-policy (ngay sau slos):&#xa;  4 ngân sách: availability 1% · error-rate 1% · latency-p95 5% · latency-p99 1%&#xa;  tuần lịch UTC+07:00 · mốc [50%, 75%, 100%] · cạn = bất kỳ ngân sách nào 100%&#xa;  on-exhausted: dừng merge tính năng mới · recovery: 3 ngày đạt SLO" vertex="1">
                    <mxGeometry height="150" width="470" x="30" y="60" as="geometry"/>
                </mxCell>
                <mxCell id="services" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" value="7 service (.NET) — ServiceDefaults&#xa;ChaosFaultInjectionMiddleware (ngay sau CorrelationIdMiddleware)&#xa;cờ Chaos:AllowFaultInjection (compose CHAOS_ALLOW_FAULT_INJECTION, mặc định false)&#xa;+ header X-Chaos-Fault: 5xx → trả 500, không chạy tiếp pipeline" vertex="1">
                    <mxGeometry height="90" width="470" x="30" y="250" as="geometry"/>
                </mxCell>
                <mxCell id="tests" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" value="Test canh gác (chạy trong CI, không cần stack)&#xa;tests/ServiceManifestSloConventionTests:&#xa;  ErrorBudgetPolicyTests — 7 manifest đúng hình dạng/con số&#xa;  ErrorBudgetRuleDefinitionTests — rule export khớp manifest&#xa;shared/ServiceDefaults.UnitTests:&#xa;  ChaosFaultInjectionMiddlewareTests — 2 lớp chặn" vertex="1">
                    <mxGeometry height="120" width="470" x="30" y="400" as="geometry"/>
                </mxCell>
                <mxCell id="otel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" value="OTel Collector → Elasticsearch&#xa;traces-generic.otel-default*&#xa;(span server: service, status_code, duration ns)" vertex="1">
                    <mxGeometry height="70" width="380" x="560" y="250" as="geometry"/>
                </mxCell>
                <mxCell id="events" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;" value="Index slo-error-budget-events (append-only)&#xa;{@timestamp, service, budget, event: exhausted}&#xa;ghi bởi connector Index khi alert mốc 100 chuyển active" vertex="1">
                    <mxGeometry height="70" width="380" x="560" y="400" as="geometry"/>
                </mxCell>
                <mxCell id="rules" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" value="Kibana Alerting — 4 rule &quot;Elasticsearch query&quot; ES|QL (license Basic)&#xa;chu kỳ 5 phút · tag slo-error-budget · groupBy row&#xa;error-budget-50 / -75 / -100: % tiêu hao từ đầu tuần,&#xa;  alert theo (service, budget), cửa sổ rule 7 ngày&#xa;error-budget-100 + action Index (khi đổi trạng thái)&#xa;error-budget-frozen: alert theo service, cửa sổ 14 ngày" vertex="1">
                    <mxGeometry height="130" width="440" x="1010" y="60" as="geometry"/>
                </mxCell>
                <mxCell id="alerts" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;" value=".alerts-stack.alerts-default&#xa;(alerts-as-data: kibana.alert.grouping.service/budget,&#xa;status active/recovered, @timestamp cập nhật mỗi lượt)" vertex="1">
                    <mxGeometry height="70" width="440" x="1010" y="250" as="geometry"/>
                </mxCell>
                <mxCell id="dashboard" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=6;" value="Dashboard &quot;SLO vận hành hằng ngày — 7 service&quot; (của 021)&#xa;nhóm trên cùng &quot;Ngân sách lỗi tuần này&quot; — 3 Discover session ES|QL:&#xa;  slo-error-budget-consumption — mức tiêu hao 7 × 4 (%)&#xa;  slo-error-budget-active-alerts — alert active (≤ 15 phút)&#xa;  slo-error-budget-frozen — cạn, ưu tiên độ tin cậy" vertex="1">
                    <mxGeometry height="110" width="440" x="1010" y="380" as="geometry"/>
                </mxCell>
                <mxCell id="key" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;dashed=1;" value="Khoá KIBANA_ENCRYPTION_KEY (.env Vùng 2) → XPACK_ENCRYPTEDSAVEDOBJECTS_ENCRYPTIONKEY — thiếu thì Alerting không chạy rule nào" vertex="1">
