        <mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="Chặn nào biết&#xa;thông tin đó&#xa;trước khi&#xa;chạm dữ liệu?" vertex="1">
          <mxGeometry height="110" width="150" x="920" y="80" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="4a. Xử lý bình thường" vertex="1">
          <mxGeometry height="60" width="200" x="1130" y="40" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" value="4b. Chặn NGAY —&#xa;không có &quot;khách&#xa;hàng mặc định&quot;" vertex="1">
