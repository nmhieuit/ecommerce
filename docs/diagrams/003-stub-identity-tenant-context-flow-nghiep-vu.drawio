<mxfile host="Electron" agent="5.0">
  <diagram id="003-flow" name="Xác định thuộc về ai, một lần">
    <mxGraphModel dx="1300" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
