        <mxCell id="title" parent="1" style="text;html=1;fontStyle=1;fontSize=16;fontColor=#333333;" value="Mọi dữ liệu đều biết mình thuộc về ai" vertex="1">
          <mxGeometry height="30" width="700" x="30" y="20" as="geometry" />
        </mxCell>

        <mxCell id="n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="1. Yêu cầu đi vào&#xa;qua cửa vào chính" vertex="1">
          <mxGeometry height="80" width="220" x="30" y="90" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" value="2. Xác định &quot;thuộc khách&#xa;hàng doanh nghiệp nào&quot;&#xa;ĐÚNG MỘT LẦN" vertex="1">
          <mxGeometry height="90" width="240" x="310" y="85" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="3. Thông tin đó đi kèm&#xa;MỌI chặng xử lý&#xa;tiếp theo" vertex="1">
