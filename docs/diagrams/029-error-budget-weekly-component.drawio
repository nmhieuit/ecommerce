    <diagram id="error-budget-weekly-component" name="Kiến trúc thành phần — ngân sách lỗi theo tuần lịch giờ Việt Nam, SLO 99%/1%">
        <mxGraphModel dx="1500" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" parent="1" style="text;html=1;fontStyle=1;fontSize=14;fontColor=#333333;" value="Kiến trúc thành phần — một con số (99% / 1%), một chu kỳ (tuần lịch UTC+7) ở hiến chương, manifest, test, rule và dashboard" vertex="1">
                    <mxGeometry height="26" width="1420" x="30" y="10" as="geometry"/>
                </mxCell>
                <mxCell id="constitution" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;" value="Hiến chương 2.0.0 — Nguyên tắc VIII (sửa đổi MAJOR)&#xa;- 99% weekly availability.&#xa;- 5xx responses below 1% of requests.&#xa;(ngưỡng độ trễ giữ nguyên)" vertex="1">
                    <mxGeometry height="90" width="470" x="30" y="60" as="geometry"/>
                </mxCell>
                <mxCell id="manifests" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" value="7× service-manifest.yaml&#xa;slos: availability 99% (weekly) · max-5xx-ratio 1% · latency p95/p99 (giữ)&#xa;error-budget-policy:&#xa;  window: calendar-week (thứ Hai 00:00 → Chủ nhật 23:59) · timezone UTC+07:00&#xa;  4 ngân sách: availability 1% · error-rate 1% · latency-p95 5% · latency-p99 1%&#xa;  mốc [50%, 75%, 100%] · cạn = bất kỳ ngân sách nào 100% · hồi phục 3 ngày" vertex="1">
                    <mxGeometry height="130" width="470" x="30" y="190" as="geometry"/>
                </mxCell>
                <mxCell id="tests" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" value="Test canh gác (CI, không cần stack)&#xa;PlatformSloDefaults 99%/1% → SloDefaultComplianceTests&#xa;ErrorBudgetPolicyTests: calendar-week, 1%/1%/5%/1%&#xa;ErrorBudgetRuleDefinitionTests: đầu tuần UTC+7, cửa sổ 7 d / 14 d,&#xa;  tỷ lệ 0.01, ngưỡng ngày đạt SLO = tỷ lệ ngân sách" vertex="1">
                    <mxGeometry height="110" width="470" x="30" y="370" as="geometry"/>
                </mxCell>
                <mxCell id="otel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" value="OTel Collector → Elasticsearch&#xa;traces-generic.otel-default*&#xa;(7 service, lỗi diễn tập tính như thật)" vertex="1">
                    <mxGeometry height="70" width="380" x="560" y="190" as="geometry"/>
                </mxCell>
                <mxCell id="events" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;" value="Index slo-error-budget-events (mapping keyword)&#xa;chỉ sự kiện từ tuần triển khai — sự kiện của chế độ tháng đã xoá" vertex="1">
