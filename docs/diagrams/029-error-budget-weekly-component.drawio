                <mxCell id="export" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;" value="Export trong repo (ndjson)&#xa;alerts/error-budget-rules.ndjson · incident-fast-detection-rule.ndjson&#xa;dashboards/slo-van-hanh-hang-ngay.ndjson" vertex="1">
