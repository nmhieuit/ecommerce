<mxfile host="Electron" agent="5.0">
  <diagram id="008-flow" name="Hợp đồng cho tin nhắn giữa các mảng">
    <mxGraphModel dx="1300" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" style="text;html=1;fontStyle=1;fontSize=16;fontColor=#333333;" value="Hợp đồng cho những &quot;tin nhắn&quot; giữa các mảng nghiệp vụ" vertex="1">
          <mxGeometry height="30" width="900" x="30" y="20" as="geometry" />
        </mxCell>

        <mxCell id="n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="1. Cần thay đổi&#xa;1 thông báo" vertex="1">
          <mxGeometry height="70" width="200" x="30" y="90" as="geometry" />
        </mxCell>
        <mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="Có phá vỡ&#xa;bên đang&#xa;nghe?" vertex="1">
          <mxGeometry height="100" width="150" x="280" y="75" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="2a. Bắt buộc đánh version&#xa;mới; bản cũ vẫn chạy&#xa;trong thời hạn công bố" vertex="1">
          <mxGeometry height="90" width="240" x="510" y="30" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="2b. Cứ thêm — bên nghe&#xa;tự bỏ qua phần lạ" vertex="1">
          <mxGeometry height="80" width="240" x="510" y="150" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="3. Không ai bị&#xa;gián đoạn" vertex="1">
          <mxGeometry height="70" width="200" x="830" y="90" as="geometry" />
        </mxCell>

        <mxCell id="e1" edge="1" parent="1" source="n1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="d1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;fontColor=#b85450;" target="n2" value="Có">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="d1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;fontColor=#2d6a2d;" target="n3" value="Không">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="n2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" target="n4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="n3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" target="n4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note" parent="1" style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;" value="Đây mới chỉ là hợp đồng — chưa có cơ chế truyền thông điệp thật sự nào được kết nối ở bước này (chưa có publisher/consumer&#xa;thật trong hệ thống đang chạy)." vertex="1">
          <mxGeometry height="30" width="900" x="30" y="250" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
