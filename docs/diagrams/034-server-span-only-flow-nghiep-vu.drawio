    <diagram id="server-span-only-flow" name="Luồng nghiệp vụ — một lỗi ở bộ phận cuối chỉ trừ ngân sách đúng bộ phận nhận yêu cầu, không nhân đôi qua lời gọi đi tiếp">
        <mxGraphModel dx="1443" dy="468" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="700" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" parent="1" style="text;html=1;fontStyle=1;fontSize=14;fontColor=#333333;" value="Luồng nghiệp vụ — khách gửi yêu cầu, bộ phận cuối lỗi: mỗi bộ phận chỉ bị tính lượt nhận yêu cầu của chính nó, không bị tính lời gọi đi tiếp" vertex="1"><mxGeometry height="26" width="1300" x="30" y="10" as="geometry"/></mxCell>
                <mxCell id="b0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" value="Khách gửi yêu cầu&#10;qua cổng vào → bộ phận ghép dữ liệu → bộ phận sản phẩm" vertex="1"><mxGeometry height="90" width="300" x="30" y="80" as="geometry"/></mxCell>
                <mxCell id="b1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=6;" value="Bộ phận cuối lỗi&#10;lỗi lan ngược lên các bộ phận gọi nó" vertex="1"><mxGeometry height="90" width="300" x="400" y="80" as="geometry"/></mxCell>
                <mxCell id="b2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;" value="Mỗi bộ phận bị tính 1 lượt lỗi&#10;đúng lượt nhận yêu cầu của chính nó (trước đây cổng và bộ phận ghép bị đếm 2)" vertex="1"><mxGeometry height="90" width="300" x="770" y="80" as="geometry"/></mxCell>
                <mxCell id="b3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" value="Lời gọi đi tiếp và gửi thông điệp&#10;không còn tính vào ngân sách" vertex="1"><mxGeometry height="90" width="300" x="30" y="250" as="geometry"/></mxCell>
                <mxCell id="b4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" value='Ô "Lỗi gọi hạ lưu"&#10;vẫn cho thấy lỗi ở lời gọi đi tiếp để biết bộ phận nào kéo bộ phận khác' vertex="1"><mxGeometry height="90" width="300" x="400" y="250" as="geometry"/></mxCell>
                <mxCell id="b5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" value="Cảnh báo mốc 50/75/100%, đóng băng và phát hiện nhanh&#10;cùng một cách đếm với hai màn hình theo dõi" vertex="1"><mxGeometry height="90" width="300" x="770" y="250" as="geometry"/></mxCell>
