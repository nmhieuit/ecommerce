<mxfile host="65bd71144e">
    <diagram id="troubleshoot-practice-docs-sequence" name="Trình tự thật (2026-10-06) — bài bất ngờ: bốc thăm, triệu chứng, tra file 17 mở dần ba mức, khôi phục, mở niêm phong">
        <mxGraphModel dx="976" dy="333" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="760" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Trình tự thật (2026-10-06) — một phiên dạng bất ngờ: -Start → triệu chứng → file 17 mức 1 → 2 → 3 (đối chiếu -Hint) → -Restore → -Reveal" style="text;html=1;fontStyle=1;fontSize=14;fontColor=#333333;" parent="1" vertex="1"><mxGeometry x="30" y="10" width="1390" height="26" as="geometry"/></mxCell>
                <mxCell id="c1" value="Người học" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="30" y="60" width="170" height="40" as="geometry"/></mxCell>
                <mxCell id="c2" value="incident-drill.ps1 + catalog.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="250" y="60" width="230" height="50" as="geometry"/></mxCell>
                <mxCell id="c3" value="Stack Docker Compose" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="530" y="60" width="230" height="50" as="geometry"/></mxCell>
                <mxCell id="c4" value="Kibana / Elasticsearch (dashboard Xử lý sự cố)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="810" y="60" width="260" height="50" as="geometry"/></mxCell>
                <mxCell id="c5" value="File 17 — gợi ý theo triệu chứng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="1120" y="60" width="260" height="50" as="geometry"/></mxCell>
                <mxCell id="r1" value="1. -Start → in runId 20261006-132014 và SHA-256 (3 dòng); chưa lộ nhóm, loại, đích; tiêm hẹn sau 120 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="30" y="140" width="640" height="40" as="geometry"/></mxCell>
                <mxCell id="r2" value="2. Tiêm (cùng cơ chế ở lần đo nhóm 4, 11:28:13): docker stop cơ sở dữ liệu; state = injected sau 6 s, không tạo lại container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="250" y="200" width="640" height="40" as="geometry"/></mxCell>
                <mxCell id="r3" value="3. Quan sát: service phụ thuộc 51,6% 5xx, BFF 25,1%, gateway 32,1%; /health/ready 503 → triệu chứng &quot;5xx ở service phía sau, lan lên&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="810" y="260" width="600" height="40" as="geometry"/></mxCell>
                <mxCell id="r4" value="4. Tra file 17, triệu chứng 1, mức 1: tìm dòng cuối chuỗi ở &quot;Lỗi gọi hạ lưu&quot;, chạy truy vấn dùng chung Q1/Q2/Q8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="850" y="320" width="560" height="40" as="geometry"/></mxCell>
                <mxCell id="r5" value="5. Mức 2: &quot;nhóm 1 hoặc nhóm 4&quot;; so cấu hình kết nối với container DB bằng docker ps -a (DB Exited ⇒ nhóm 4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="850" y="380" width="560" height="40" as="geometry"/></mxCell>
                <mxCell id="r6" value="6. Mức 3 (loại E): đáp án + khôi phục. Đối chiếu -Hint: mức 1/2/3 trả &quot;503 dù tiến trình vẫn chạy&quot;, &quot;Nhóm 4&quot;, &quot;Loại E … parties-db&quot;; hint-log.json 3 dòng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="30" y="440" width="760" height="50" as="geometry"/></mxCell>
                <mxCell id="r7" value="7. -Restore → docker start DB, chờ /health/ready 200 (48 s; service tự về healthy, không khởi động lại)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="250" y="510" width="640" height="40" as="geometry"/></mxCell>
                <mxCell id="r8" value="8. Xác nhận: phút đầu tiên dat = true sau 1 phút; mốc giải quyết cần 15 phút liên tục (truy vấn file 08)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="810" y="570" width="600" height="40" as="geometry"/></mxCell>
                <mxCell id="r9" value="9. -Reveal → băm khớp; in lựa chọn, thời điểm tiêm/khôi phục và số lần xin gợi ý; điền bản ghi sự cố" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="30" y="630" width="640" height="40" as="geometry"/></mxCell>
                <mxCell id="note" value="Phiên bốc thăm thật (bước 1, 6, 9) chạy lúc 13:20 và huỷ trước khi tiêm (-Restore khi còn pending); số đo bước 2–3 và 7–8 lấy từ lần chạy loại E có chủ đích lúc 11:28–11:35 cùng ngày. Người viết đã biết đáp án nên chỉ kiểm cấu trúc, không kiểm độ khó." style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;fontStyle=2;" parent="1" vertex="1"><mxGeometry x="30" y="690" width="1380" height="40" as="geometry"/></mxCell>
                <mxCell id="t1" value="-Start" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="c1" target="c2" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="t2" value="tiêm" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="c2" target="c3" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="t3" value="telemetry" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="c3" target="c4" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="t4" value="tra theo triệu chứng" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;dashed=1;" parent="1" source="c1" target="c5" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
