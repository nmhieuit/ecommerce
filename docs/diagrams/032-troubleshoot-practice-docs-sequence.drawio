                <mxCell id="c5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" value="File 17 — gợi ý theo triệu chứng" vertex="1">
                    <mxGeometry height="50" width="260" x="1120" y="60" as="geometry"/>
                </mxCell>
                <mxCell id="r1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;" value="1. -Start → in runId 20261006-132014 và SHA-256 (3 dòng); chưa lộ nhóm, loại, đích; tiêm hẹn sau 120 s" vertex="1">
                    <mxGeometry height="40" width="640" x="30" y="140" as="geometry"/>
                </mxCell>
                <mxCell id="r2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;" value="2. Tiêm (cùng cơ chế ở lần đo nhóm 4, 11:28:13): docker stop cơ sở dữ liệu; state = injected sau 6 s, không tạo lại container" vertex="1">
                    <mxGeometry height="40" width="640" x="250" y="200" as="geometry"/>
                </mxCell>
                <mxCell id="r3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=6;" value="3. Quan sát: service phụ thuộc 51,6% 5xx, BFF 25,1%, gateway 32,1%; /health/ready 503 → triệu chứng &quot;5xx ở service phía sau, lan lên&quot;" vertex="1">
                    <mxGeometry height="40" width="600" x="810" y="260" as="geometry"/>
                </mxCell>
                <mxCell id="r4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" value="4. Tra file 17, triệu chứng 1, mức 1: tìm dòng cuối chuỗi ở &quot;Lỗi gọi hạ lưu&quot;, chạy truy vấn dùng chung Q1/Q2/Q8" vertex="1">
                    <mxGeometry height="40" width="560" x="850" y="320" as="geometry"/>
                </mxCell>
                <mxCell id="r5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" value="5. Mức 2: &quot;nhóm 1 hoặc nhóm 4&quot;; so cấu hình kết nối với container DB bằng docker ps -a (DB Exited ⇒ nhóm 4)" vertex="1">
                    <mxGeometry height="40" width="560" x="850" y="380" as="geometry"/>
                </mxCell>
                <mxCell id="r6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" value="6. Mức 3 (loại E): đáp án + khôi phục. Đối chiếu -Hint: mức 1/2/3 trả &quot;503 dù tiến trình vẫn chạy&quot;, &quot;Nhóm 4&quot;, &quot;Loại E … parties-db&quot;; hint-log.json 3 dòng" vertex="1">
                    <mxGeometry height="50" width="760" x="30" y="440" as="geometry"/>
                </mxCell>
                <mxCell id="r7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" value="7. -Restore → docker start DB, chờ /health/ready 200 (48 s; service tự về healthy, không khởi động lại)" vertex="1">
                    <mxGeometry height="40" width="640" x="250" y="510" as="geometry"/>
                </mxCell>
                <mxCell id="r8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" value="8. Xác nhận: phút đầu tiên dat = true sau 1 phút; mốc giải quyết cần 15 phút liên tục (truy vấn file 08)" vertex="1">
                    <mxGeometry height="40" width="600" x="810" y="570" as="geometry"/>
                </mxCell>
                <mxCell id="r9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" value="9. -Reveal → băm khớp; in lựa chọn, thời điểm tiêm/khôi phục và số lần xin gợi ý; điền bản ghi sự cố" vertex="1">
                    <mxGeometry height="40" width="640" x="30" y="630" as="geometry"/>
                </mxCell>
                <mxCell id="note" parent="1" style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;fontStyle=2;" value="Phiên bốc thăm thật (bước 1, 6, 9) chạy lúc 13:20 và huỷ trước khi tiêm (-Restore khi còn pending); số đo bước 2–3 và 7–8 lấy từ lần chạy loại E có chủ đích lúc 11:28–11:35 cùng ngày. Người viết đã biết đáp án nên chỉ kiểm cấu trúc, không kiểm độ khó." vertex="1">
