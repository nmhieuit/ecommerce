<mxfile host="Electron" agent="5.0">
  <diagram id="009-flow" name="Kiểm chứng lại các quy tắc tính tiền">
    <mxGraphModel dx="1300" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="380" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" style="text;html=1;fontStyle=1;fontSize=16;fontColor=#333333;" value="Kiểm chứng lại các quy tắc tính tiền — bằng cách cố tình phá vỡ" vertex="1">
          <mxGeometry height="30" width="900" x="30" y="20" as="geometry" />
        </mxCell>

        <mxCell id="n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="1. Rà soát 1 quy&#xa;tắc tính tiền" vertex="1">
          <mxGeometry height="70" width="200" x="30" y="90" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" value="2. Cố tình gỡ bỏ&#xa;tạm thời" vertex="1">
          <mxGeometry height="70" width="200" x="300" y="90" as="geometry" />
        </mxCell>
        <mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="Bài kiểm tra&#xa;có bắt được&#xa;không?" vertex="1">
          <mxGeometry height="100" width="150" x="560" y="75" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="3. Khôi phục — quy tắc&#xa;được bảo vệ THẬT" vertex="1">
          <mxGeometry height="70" width="230" x="800" y="90" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="4. Ghi kỷ luật làm&#xa;việc cho tương lai" vertex="1">
          <mxGeometry height="70" width="220" x="1090" y="90" as="geometry" />
        </mxCell>

        <mxCell id="e1" edge="1" parent="1" source="n1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" target="n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="n2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="d1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;fontColor=#2d6a2d;" target="n3" value="Có">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="n3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" target="n4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note" parent="1" style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;" value="Kết quả rà soát thực tế: cả 6 quy tắc quan trọng đều đã đúng và đã có bài kiểm tra bảo vệ từ trước — không có mã nào cần viết lại." vertex="1">
          <mxGeometry height="30" width="1000" x="30" y="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
