<mxfile host="65bd71144e">
    <diagram id="identity-server-flow-nghiep-vu" name="Vé thông hành — từ đăng nhập tới lúc yêu cầu được xử lý">
        <mxGraphModel dx="1699" dy="527" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="750" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Vé thông hành (token) — từ lúc đăng nhập tới lúc một yêu cầu được xử lý" style="text;html=1;fontStyle=1;fontSize=16;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="30" y="20" width="1100" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="n1" value="1. Người dùng đăng nhập&#xa;với thông tin thật" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="90" width="220" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="n2" value="2. Máy chủ định danh cấp&#xa;một &quot;vé thông hành&quot; mang theo&#xa;danh tính + tenant, có chữ ký&#xa;không thể giả mạo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="310" y="75" width="240" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="n3" value="3. Vé được gửi kèm mọi yêu cầu.&#xa;MỖI bộ phận nhận được yêu cầu&#xa;— không chỉ cổng vào chính —&#xa;tự kiểm tra lại vé độc lập" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="610" y="75" width="250" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="d1" value="Vé còn hợp lệ&#xa;tại bộ phận đó?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="920" y="70" width="160" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="n4" value="4a. Yêu cầu được xử lý&#xa;bình thường — danh tính/tenant&#xa;dùng đúng như trước" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1160" y="20" width="230" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="n5" value="4b. Bị từ chối NGAY tại đúng&#xa;bộ phận nhận được vé — dù&#xa;yêu cầu có đi qua cổng chính&#xa;hay không" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1160" y="160" width="230" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="n6" value="Không có &quot;đường vòng&quot; nào —&#xa;cố tình bỏ qua cổng chính vẫn&#xa;bị chặn ở đúng nơi nhận được" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontColor=#7a1f1f;" parent="1" vertex="1">
                    <mxGeometry x="1160" y="280" width="230" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="n7" value="5. Nếu lý do là &quot;vé hết hạn&quot;:&#xa;người dùng thấy thông báo rõ&#xa;ràng &quot;cần đăng nhập lại&quot; —&#xa;không phải lỗi khó hiểu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="850" y="420" width="240" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="note1" value="&quot;Mỗi bộ phận tự kiểm tra lại&quot; nghĩa là: kể cả khi cổng vào chính bị bỏ qua, cấu hình sai, hoặc gặp sự cố, các bộ phận phía&#xa;sau vẫn tự bảo vệ được chính mình — không có một điểm duy nhất mà nếu hỏng thì toàn bộ phòng thủ sụp đổ theo." style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;" parent="1" vertex="1">
                    <mxGeometry x="310" y="220" width="850" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" parent="1" source="n1" target="n2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" parent="1" source="n2" target="n3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" parent="1" source="n3" target="d1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4" value="Có" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;fontColor=#2d6a2d;" parent="1" source="d1" target="n4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e5" value="Không (hết hạn&#xa;hoặc giả mạo)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;fontColor=#b85450;" parent="1" source="d1" target="n5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;dashed=1;" parent="1" source="n5" target="n6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e7" value="nếu lý do là hết hạn" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;exitX=0;exitY=0.75;entryX=1;entryY=0.3;exitDx=0;exitDy=0;" parent="1" source="n5" target="n7" edge="1">
                    <mxGeometry x="0.3208" relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1110" y="235"/>
                            <mxPoint x="1110" y="450"/>
                        </Array>
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
