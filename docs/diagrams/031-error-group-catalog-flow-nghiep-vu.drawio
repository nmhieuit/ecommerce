<mxfile host="65bd71144e">
    <diagram id="error-group-catalog-flow-nghiep-vu" name="Luồng nghiệp vụ — luyện xử lý sự cố theo nhóm lỗi, có chủ đích hoặc bất ngờ">
        <mxGraphModel dx="976" dy="333" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="560" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Luồng nghiệp vụ — chọn cách luyện, gây lỗi, quan sát triệu chứng, xin gợi ý khi cần, khôi phục, đối chiếu" style="text;html=1;fontStyle=1;fontSize=14;fontColor=#333333;" parent="1" vertex="1"><mxGeometry x="30" y="10" width="1300" height="26" as="geometry"/></mxCell>
                <mxCell id="f1" value="1. Chọn cách luyện:&#xa;có chủ đích theo nhóm&#xa;hoặc bất ngờ không báo trước" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="30" y="60" width="240" height="70" as="geometry"/></mxCell>
                <mxCell id="f2a" value="2a. Có chủ đích: chọn nhóm và&#xa;bộ phận, có thể hẹn giờ tự gỡ;&#xa;hệ thống nói rõ đã gây gì" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="310" y="40" width="260" height="80" as="geometry"/></mxCell>
                <mxCell id="f2b" value="2b. Bất ngờ: hệ thống bốc thăm&#xa;một nhóm, chỉ đưa mã niêm phong;&#xa;lỗi xuất hiện trong 0–30 phút" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="310" y="150" width="260" height="80" as="geometry"/></mxCell>
                <mxCell id="f3" value="3. Quan sát triệu chứng&#xa;trên màn hình theo dõi&#xa;và tự tìm nguyên nhân" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="620" y="90" width="240" height="80" as="geometry"/></mxCell>
                <mxCell id="d1" value="Bế tắc?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="910" y="90" width="140" height="60" as="geometry"/></mxCell>
                <mxCell id="f4" value="Xin gợi ý theo mức:&#xa;1 triệu chứng · 2 nhóm lỗi · 3 đáp án&#xa;mỗi lần xin được ghi lại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="910" y="190" width="240" height="70" as="geometry"/></mxCell>
                <mxCell id="f5" value="4. Khôi phục bằng một lệnh;&#xa;chờ bộ phận bị lỗi khoẻ lại&#xa;(tối đa 10 phút)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="620" y="290" width="240" height="80" as="geometry"/></mxCell>
                <mxCell id="f6" value="5. Mở niêm phong, đối chiếu&#xa;với nguyên nhân tự tìm ra;&#xa;xem số lần xin gợi ý" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="310" y="290" width="260" height="80" as="geometry"/></mxCell>
                <mxCell id="f7" value="6. Lỗi vẫn tính vào ngân sách lỗi&#xa;tuần như sự cố thật;&#xa;ghi bản ghi sự cố nếu là bài mù" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="30" y="290" width="240" height="80" as="geometry"/></mxCell>
                <mxCell id="n1" value="Tám nhóm lỗi: đích kết nối sai · nghẽn và lỗi theo tỷ lệ · độ trễ · hạ tầng dừng · xác thực hỏng · thiếu tài nguyên · mạng đứt · container chết." style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;fontStyle=2;" parent="1" vertex="1"><mxGeometry x="30" y="420" width="1300" height="30" as="geometry"/></mxCell>
                <mxCell id="a1" value="có chủ đích" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="f1" target="f2a" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="a2" value="bất ngờ" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="f1" target="f2b" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="f2a" target="f3" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="a4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="f2b" target="f3" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="a5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="f3" target="d1" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="a6" value="có" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="d1" target="f4" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="a7" value="quay lại" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;dashed=1;" parent="1" source="f4" target="f3" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="a8" value="tìm ra" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="d1" target="f5" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="a9" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="f5" target="f6" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="a10" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="f6" target="f7" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
            </root>
        </mxGraphModel>
