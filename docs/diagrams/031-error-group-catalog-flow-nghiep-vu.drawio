<mxfile host="65bd71144e">
    <diagram id="error-group-catalog-flow-nghiep-vu" name="Luồng nghiệp vụ — luyện xử lý sự cố theo nhóm lỗi, có chủ đích hoặc bất ngờ">
        <mxGraphModel dx="1374" dy="520" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="560" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" parent="1" style="text;html=1;fontStyle=1;fontSize=14;fontColor=#333333;" value="Luồng nghiệp vụ — chọn cách luyện, gây lỗi, quan sát triệu chứng, xin gợi ý khi cần, khôi phục, đối chiếu" vertex="1">
                    <mxGeometry height="26" width="1300" x="30" y="10" as="geometry"/>
                </mxCell>
                <mxCell id="f1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" value="1. Chọn cách luyện:&#xa;có chủ đích theo nhóm&#xa;hoặc bất ngờ không báo trước" vertex="1">
                    <mxGeometry height="70" width="240" x="30" y="60" as="geometry"/>
                </mxCell>
                <mxCell id="f2a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=6;" value="2a. Có chủ đích: chọn nhóm và&#xa;bộ phận, có thể hẹn giờ tự gỡ;&#xa;hệ thống nói rõ đã gây gì" vertex="1">
                    <mxGeometry height="80" width="260" x="310" y="40" as="geometry"/>
                </mxCell>
                <mxCell id="f2b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;" value="2b. Bất ngờ: hệ thống bốc thăm&#xa;một nhóm, chỉ đưa mã niêm phong;&#xa;lỗi xuất hiện trong 0–30 phút" vertex="1">
                    <mxGeometry height="80" width="260" x="310" y="150" as="geometry"/>
                </mxCell>
                <mxCell id="f3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" value="3. Quan sát triệu chứng&#xa;trên màn hình theo dõi&#xa;và tự tìm nguyên nhân" vertex="1">
                    <mxGeometry height="80" width="240" x="620" y="90" as="geometry"/>
                </mxCell>
                <mxCell id="d1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" value="Bế tắc?" vertex="1">
                    <mxGeometry height="60" width="140" x="910" y="90" as="geometry"/>
                </mxCell>
                <mxCell id="f4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" value="Xin gợi ý theo mức:&#xa;1 triệu chứng · 2 nhóm lỗi · 3 đáp án&#xa;mỗi lần xin được ghi lại" vertex="1">
                    <mxGeometry height="70" width="240" x="910" y="190" as="geometry"/>
                </mxCell>
                <mxCell id="f5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" value="4. Khôi phục bằng một lệnh;&#xa;chờ bộ phận bị lỗi khoẻ lại&#xa;(tối đa 10 phút)" vertex="1">
                    <mxGeometry height="80" width="240" x="620" y="290" as="geometry"/>
                </mxCell>
                <mxCell id="f6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" value="5. Mở niêm phong, đối chiếu&#xa;với nguyên nhân tự tìm ra;&#xa;xem số lần xin gợi ý" vertex="1">
                    <mxGeometry height="80" width="260" x="310" y="290" as="geometry"/>
                </mxCell>
                <mxCell id="f7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;" value="6. Lỗi vẫn tính vào ngân sách lỗi&#xa;tuần như sự cố thật;&#xa;ghi bản ghi sự cố nếu là bài mù" vertex="1">
