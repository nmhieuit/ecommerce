<mxfile host="Electron" agent="5.0">
  <diagram id="identity-server-flow-nghiep-vu" name="Vé thông hành — từ đăng nhập tới lúc yêu cầu được xử lý">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" style="text;html=1;fontStyle=1;fontSize=16;fontColor=#333333;" value="Vé thông hành (token) — từ lúc đăng nhập tới lúc một yêu cầu được xử lý" vertex="1">
          <mxGeometry height="30" width="1100" x="30" y="20" as="geometry" />
        </mxCell>

        <mxCell id="n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="1. Người dùng đăng nhập&#xa;với thông tin thật" vertex="1">
          <mxGeometry height="80" width="220" x="30" y="90" as="geometry" />
        </mxCell>

        <mxCell id="n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="2. Máy chủ định danh cấp&#xa;một &quot;vé thông hành&quot; mang theo&#xa;danh tính + tenant, có chữ ký&#xa;không thể giả mạo" vertex="1">
          <mxGeometry height="110" width="240" x="310" y="75" as="geometry" />
        </mxCell>

        <mxCell id="n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" value="3. Vé được gửi kèm mọi yêu cầu.&#xa;MỖI bộ phận nhận được yêu cầu&#xa;— không chỉ cổng vào chính —&#xa;tự kiểm tra lại vé độc lập" vertex="1">
          <mxGeometry height="110" width="250" x="610" y="75" as="geometry" />
        </mxCell>

        <mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="Vé còn hợp lệ&#xa;tại bộ phận đó?" vertex="1">
          <mxGeometry height="120" width="160" x="920" y="70" as="geometry" />
        </mxCell>

        <mxCell id="n4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="4a. Yêu cầu được xử lý&#xa;bình thường — danh tính/tenant&#xa;dùng đúng như trước" vertex="1">
          <mxGeometry height="90" width="230" x="1140" y="20" as="geometry" />
        </mxCell>

        <mxCell id="n5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" value="4b. Bị từ chối NGAY tại đúng&#xa;bộ phận nhận được vé — dù&#xa;yêu cầu có đi qua cổng chính&#xa;hay không" vertex="1">
          <mxGeometry height="100" width="230" x="1140" y="160" as="geometry" />
        </mxCell>

        <mxCell id="n6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontColor=#7a1f1f;" value="Không có &quot;đường vòng&quot; nào —&#xa;cố tình bỏ qua cổng chính vẫn&#xa;bị chặn ở đúng nơi nhận được" vertex="1">
          <mxGeometry height="80" width="230" x="1140" y="280" as="geometry" />
        </mxCell>

        <mxCell id="n7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="5. Nếu lý do là &quot;vé hết hạn&quot;:&#xa;người dùng thấy thông báo rõ&#xa;ràng &quot;cần đăng nhập lại&quot; —&#xa;không phải lỗi khó hiểu" vertex="1">
          <mxGeometry height="100" width="240" x="850" y="420" as="geometry" />
        </mxCell>

        <mxCell id="note1" parent="1" style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;" value="&quot;Mỗi bộ phận tự kiểm tra lại&quot; nghĩa là: kể cả khi cổng vào chính bị bỏ qua, cấu hình sai, hoặc gặp sự cố, các bộ phận phía&#xa;sau vẫn tự bảo vệ được chính mình — không có một điểm duy nhất mà nếu hỏng thì toàn bộ phòng thủ sụp đổ theo." vertex="1">
          <mxGeometry height="40" width="850" x="310" y="220" as="geometry" />
        </mxCell>

        <mxCell id="e1" edge="1" parent="1" source="n1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" target="n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="n2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" target="n3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="n3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="d1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;fontColor=#2d6a2d;" target="n4" value="Có">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="d1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;fontColor=#b85450;" target="n5" value="Không (hết hạn&#xa;hoặc giả mạo)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="n5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;dashed=1;" target="n6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="n5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;exitX=0.5;exitY=1;entryX=1;entryY=0.3;" target="n7" value="nếu lý do là hết hạn">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1255" y="500" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
