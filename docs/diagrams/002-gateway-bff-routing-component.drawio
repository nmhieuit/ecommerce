        </mxCell>

        <mxCell id="note" parent="1" style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;" value="Nếu một domain service không phản hồi hoặc chậm: BFF trả về lỗi ProblemDetails có cấu trúc trong thời gian giới hạn (SC-003: dưới 5 giây),&#xa;không để request treo vô thời hạn (research.md Decision 4)." vertex="1">
          <mxGeometry height="40" width="1000" x="330" y="250" as="geometry" />
        </mxCell>
      </root>
