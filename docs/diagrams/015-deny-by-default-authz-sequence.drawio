<mxfile host="65bd71144e">
    <diagram id="deny-by-default-authz-sequence" name="Trình tự — chính sách ApiScope, nhánh toggle bật/tắt, 403 rõ ràng">
        <mxGraphModel dx="1499" dy="527" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1150" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Trình tự — request qua chính sách ApiScope, ba nhánh (toggle tắt / toggle bật thiếu scope / toggle bật đủ scope)" style="text;html=1;fontStyle=1;fontSize=14;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="30" y="10" width="1200" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="Áp dụng độc lập, giống hệt nhau, tại mỗi hop: Gateway (FallbackPolicy trên MapReverseProxy), BFF, và mỗi domain service — không hop nào tin hop trước đã kiểm tra thay mình (constitution Principle VI, kế thừa từ 014)." style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="30" y="36" width="1200" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="h_client" value="Client&#xa;(đã có token Valid từ 014)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="80" width="200" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="h_svc" value="Service.Api&#xa;(BFF hoặc bất kỳ domain service)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="420" y="80" width="260" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="h_handler" value="RequireApiScopeAuthorizationHandler&#xa;+ ClearForbiddenResponseEvents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="850" y="80" width="300" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="l_client" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="130" y="130" as="sourcePoint"/>
                        <mxPoint x="130" y="1100" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="l_svc" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="550" y="130" as="sourcePoint"/>
                        <mxPoint x="550" y="1100" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="l_handler" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1000" y="130" as="sourcePoint"/>
                        <mxPoint x="1000" y="1100" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="a1" style="endArrow=block;html=1;fontSize=10;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="130" y="160" as="sourcePoint"/>
                        <mxPoint x="550" y="160" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="a1t" value="1. Request kèm Authorization: Bearer &lt;token&gt;" style="text;html=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="150" y="142" width="380" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="box_policy" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;2. AuthorizationMiddleware đánh giá chính sách trên route:&lt;br&gt;    - route đã khai báo .RequireAuthorization(ApiScope) → dùng policy đó&lt;br&gt;    - route chưa khai báo (lẽ ra không tồn tại — scanner chặn) → FallbackPolicy&lt;br&gt;      (đã nâng cấp, cùng nội dung requirement)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;fontSize=9;verticalAlign=top;align=left;spacingLeft=8;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="420" y="190" width="500" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="a2" style="endArrow=block;html=1;fontSize=10;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="550" y="290" as="sourcePoint"/>
                        <mxPoint x="1000" y="290" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="a2t" value="3. Đánh giá RequireApiScopeRequirement" style="text;html=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="580" y="272" width="380" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="box_handler" value="4. Handler đọc IOptionsMonitor&lt;AuthorizationToggleOptions&gt;.CurrentValue&#xa;    MỖI lần đánh giá (không cache) — hot-reload có hiệu lực ngay (Principle X)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d79b00;dashed=1;fontSize=9;verticalAlign=top;align=left;spacingLeft=8;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="850" y="310" width="300" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="branchA" value="Nhánh A — Toggle AuthorizationRequireApiScope TẮT (giữ đúng hành vi trước tính năng 015)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0fff0;strokeColor=#82b366;fontSize=10;verticalAlign=top;align=left;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="30" y="390" width="1120" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="aA1" style="endArrow=block;html=1;fontSize=10;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1000" y="440" as="sourcePoint"/>
                        <mxPoint x="550" y="440" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="aA1t" value="A1. Succeed() vô điều kiện — bỏ qua việc kiểm tra claim scope" style="text;html=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="600" y="422" width="450" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="aA2" style="endArrow=block;html=1;fontSize=10;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="550" y="490" as="sourcePoint"/>
                        <mxPoint x="130" y="490" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="aA2t" value="A2. Policy pass — request tới tay handler nghiệp vụ, xử lý bình thường (200/201/...)" style="text;html=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="150" y="472" width="700" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="branchB" value="Nhánh B — Toggle BẬT, token thiếu claim scope=ecommerce-api (spec US1 Acceptance Scenario 2, Test Scenario 2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#b85450;fontSize=10;verticalAlign=top;align=left;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="30" y="540" width="1120" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="aB1" style="endArrow=block;html=1;fontSize=10;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1000" y="590" as="sourcePoint"/>
                        <mxPoint x="550" y="590" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="aB1t" value="B1. Claim &quot;scope&quot; không chứa &quot;ecommerce-api&quot; — requirement KHÔNG Succeed()" style="text;html=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="580" y="572" width="450" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="aB2" style="endArrow=block;html=1;fontSize=10;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1000" y="630" as="sourcePoint"/>
                        <mxPoint x="1000" y="660" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="aB2t" value="B2. PolicyAuthorizationResult.Forbidden → ClearForbiddenResponseEvents xử lý" style="text;html=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="600" y="622" width="500" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="aB3" style="endArrow=block;html=1;fontSize=10;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1000" y="680" as="sourcePoint"/>
                        <mxPoint x="130" y="680" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="aB3t" value="B3. 403 {&quot;error&quot;:&quot;forbidden_scope&quot;,&quot;message&quot;:&quot;Authentication succeeded, but the token does not carry the required scope.&quot;}" style="text;html=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="150" y="662" width="850" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="aB4t" value="Khác với 401 (014): đây là đã xác thực thành công, chỉ thiếu đúng quyền — client biết rõ &quot;đăng nhập lại&quot; không giải quyết được vấn đề này." style="text;html=1;fontSize=9;fontColor=#7a1f1f;" parent="1" vertex="1">
                    <mxGeometry x="150" y="690" width="900" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="branchC" value="Nhánh C — Toggle BẬT, token có đủ claim scope=ecommerce-api (đường đi bình thường sau 015)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0fff0;strokeColor=#82b366;fontSize=10;verticalAlign=top;align=left;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="30" y="740" width="1120" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="aC1" style="endArrow=block;html=1;fontSize=10;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1000" y="790" as="sourcePoint"/>
                        <mxPoint x="550" y="790" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="aC1t" value="C1. Claim &quot;scope&quot; chứa &quot;ecommerce-api&quot; — Succeed()" style="text;html=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="600" y="772" width="450" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="aC2" style="endArrow=block;html=1;fontSize=10;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="550" y="840" as="sourcePoint"/>
                        <mxPoint x="130" y="840" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="aC2t" value="C2. Policy pass — request tới tay handler nghiệp vụ, xử lý bình thường (200/201/...)" style="text;html=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="150" y="822" width="700" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="footer" value="Ghi chú: một request không có token / token giả mạo / hết hạn không tới được bước 2 ở trên — bị chặn ở bước xác thực (401), hành vi không đổi từ 014-identity-server-auth." style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;" parent="1" vertex="1">
                    <mxGeometry x="30" y="890" width="1100" height="40" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>