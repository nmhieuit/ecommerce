        <mxCell id="n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="3. Sinh lại mã giao&#xa;diện bằng 1 lệnh,&#xa;&lt;1 phút" vertex="1">
