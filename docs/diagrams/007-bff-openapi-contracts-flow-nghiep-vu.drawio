        <mxCell id="title" parent="1" style="text;html=1;fontStyle=1;fontSize=16;fontColor=#333333;" value="Hợp đồng làm luật — giao diện không thể trôi lệch khỏi thực tế" vertex="1">
          <mxGeometry height="30" width="900" x="30" y="20" as="geometry" />
