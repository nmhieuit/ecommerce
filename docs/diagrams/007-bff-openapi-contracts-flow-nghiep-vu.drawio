        <mxCell id="note" parent="1" style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;" value="Mã giao diện gọi API không do con người viết tay — được sinh ra tự động từ hợp đồng — nên không có cách nào để nó lệch khỏi thực tế." vertex="1">
