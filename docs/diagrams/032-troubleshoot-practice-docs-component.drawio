                <mxCell id="title" value="Kiến trúc thành phần — tài liệu luyện troubleshoot (spec 032): 8 file nhóm + file triệu chứng, đối chiếu danh mục 031, test chỉ kiểm phủ và link" style="text;html=1;fontStyle=1;fontSize=14;fontColor=#333333;" parent="1" vertex="1"><mxGeometry x="30" y="10" width="1440" height="26" as="geometry"/></mxCell>
                <mxCell id="learner" value="Người học&#xa;chạy lệnh trong terminal, đọc file hướng dẫn,&#xa;đối chiếu số liệu trên Kibana" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="30" y="60" width="300" height="90" as="geometry"/></mxCell>
                <mxCell id="guides" value="docs/kibana-quan-sat-he-thong/&#xa;09–16: hướng dẫn step by step mỗi nhóm lỗi (nhóm 2 gộp B + C)&#xa;triệu chứng · nơi nhìn · truy vấn · khôi phục · xác nhận · bài tập · &quot;đã đạt&quot;&#xa;17: gợi ý theo TRIỆU CHỨNG, 3 mức nhẹ → mạnh → đáp án&#xa;00: lộ trình 01–17" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="380" y="60" width="560" height="130" as="geometry"/></mxCell>
                <mxCell id="triage" value="Quy trình triage + bản ghi sự cố (028)&#xa;docs/dien-tap-chaos-engineering/README.md · mau-ban-ghi-su-co.md&#xa;file 08: truy vấn xác nhận khôi phục 15 phút&#xa;— chỉ liên kết, không chép" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="380" y="230" width="560" height="100" as="geometry"/></mxCell>
                <mxCell id="catalog" value="scripts/incident-drill/catalog.json (031 — KHÔNG sửa)&#xa;8 nhóm · 9 loại A–I · 3 mức gợi ý cho -Hint&#xa;là khoá phủ của test; nội dung gợi ý viết riêng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="990" y="60" width="460" height="100" as="geometry"/></mxCell>
                <mxCell id="script" value="scripts/incident-drill.ps1 (031 — KHÔNG sửa)&#xa;-Inject (dạng a) · -Start (dạng b) · -Restore · -Hint · -Reveal · -Load" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="990" y="200" width="460" height="80" as="geometry"/></mxCell>
                <mxCell id="stack" value="Docker Compose local (docker-compose.local.yml)&#xa;7 service app · 5 DB — lỗi tiêm bằng cấu hình/công cụ Docker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="990" y="320" width="460" height="80" as="geometry"/></mxCell>
                <mxCell id="elastic" value="OTel Collector → Elasticsearch / Kibana&#xa;dashboard Xử lý sự cố · rule incident-fast-detection&#xa;traces / logs / metrics-generic.otel-default*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="380" y="380" width="560" height="100" as="geometry"/></mxCell>
                <mxCell id="test" value="tests/TroubleshootGuideConventionTests (xUnit, mới)&#xa;mỗi nhóm có file · mỗi loại có mục · file 17 đủ 3 mức, đủ A–I&#xa;mức 1–2 không lộ mã loại/tên service · link nội bộ có đích thật&#xa;KHÔNG kiểm nội dung khớp catalog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="30" y="380" width="300" height="130" as="geometry"/></mxCell>
                <mxCell id="postman" value="Folder Postman 32 - Luyện troubleshoot&#xa;8 subfolder nhóm 1–8: request quan sát triệu chứng&#xa;và request xác nhận khỏi; tiêm/khôi phục ngoài Postman" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="990" y="440" width="460" height="100" as="geometry"/></mxCell>
                <mxCell id="note" value="Spec 032 chỉ thêm tài liệu, test tài liệu, folder Postman và tài liệu đi kèm; không file nào dưới scripts/, services/, shared/, docker/, deploy/ bị sửa. Tài liệu và catalog.json viết riêng nên có thể lệch (ghi trong technical-debt); test chỉ kiểm phủ." style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;fontStyle=2;" parent="1" vertex="1"><mxGeometry x="380" y="520" width="1070" height="50" as="geometry"/></mxCell>
