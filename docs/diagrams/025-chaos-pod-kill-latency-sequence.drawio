<mxfile host="65bd71144e">
    <diagram id="chaos-pod-kill-latency-sequence" name="Trình tự thật — tiêm độ trễ, circuit breaker không trip">
        <mxGraphModel dx="1499" dy="527" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="650" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Tiêm độ trễ thật (phiên 4, autocannon) — circuit breaker vẫn không trip" style="text;html=1;fontStyle=1;fontSize=14;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="30" y="10" width="1000" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="c1" value="autocannon&#xa;(50 kết nối × 25s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="60" width="220" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="c2" value="Bff.Api → OrdersApiClient" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="580" y="60" width="240" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="c3" value="Orders.Api&#xa;ChaosLatencyInjectionMiddleware" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1120" y="60" width="240" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r1" value="1. Header X-Chaos-Latency-Ms: 3000 gửi kèm mọi request&#xa;(Chaos:AllowLatencyInjection=true trên pod diễn tập)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="30" y="140" width="600" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r2" value="2. Middleware trì hoãn ~2.35-3s mỗi request&#xa;trước khi gọi next() — status/body không đổi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="1120" y="200" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="r3" value="3. AttemptTimeout=1s bị vượt liên tục → Polly retry engage thật&#xa;(log xác nhận: OrdersApi-standard//Standard-Retry)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="580" y="290" width="600" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r4" value="4. Kết quả thật: chỉ 1/100 request lỗi (504) — rải rác, không đủ mật độ&#xa;→ CIRCUIT BREAKER KHÔNG TRIP (4/4 lần thử độc lập, kể cả với autocannon)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="30" y="380" width="900" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="r5" value="5. Kết luận (research.md): Task.Delay không chặn thread là quyết định&#xa;CÓ CHỦ ĐÍCH (không làm sập hạ tầng thật) — hệ quả &quot;không đủ áp lực tài nguyên&quot;&#xa;là đánh đổi đã biết, không phải lỗi thiết kế ngoài dự kiến" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontStyle=2;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="30" y="470" width="900" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="c1" target="r1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" parent="1" source="r1" target="r2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
