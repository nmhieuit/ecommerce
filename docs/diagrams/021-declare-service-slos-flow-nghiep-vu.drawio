                <mxCell id="title" value="Phát hiện sớm 1 bộ phận đang &quot;lố ngân sách&quot; hiệu năng — trước khi khách hàng than phiền" style="text;html=1;fontStyle=1;fontSize=14;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="30" y="10" width="1200" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="s1" value="Mỗi bộ phận đã cam kết sẵn 1 con số cụ thể&#xa;(vd &quot;phản hồi trong 150ms với 95% số lần gọi&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="30" y="80" width="380" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="s2" value="1 bộ phận thật sự chậm đi bất thường&#xa;(vd do lượng khách tăng đột biến)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="460" y="80" width="380" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="s3" value="Người quản lý mở đúng 1 nơi tra cứu&#xa;— thấy ngay số liệu thực tế cạnh số đã cam kết,&#xa;phát hiện độ trễ đã vượt xa ngân sách" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="890" y="80" width="360" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="s4" value="Xử lý sớm, chủ động — trước khi khách hàng&#xa;phải lên tiếng than phiền về việc chậm/lỗi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="890" y="220" width="360" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="s5" value="Song song, ngay từ đầu: mọi bộ phận mới thêm vào&#xa;đều BẮT BUỘC phải có cam kết này — hệ thống tự nhắc&#xa;nếu quên, không cần chờ ai rà soát thủ công" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1">
