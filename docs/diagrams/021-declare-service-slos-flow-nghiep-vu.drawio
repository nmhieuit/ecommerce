    <diagram id="declare-service-slos-flow" name="Luồng nghiệp vụ — phát hiện sớm 1 bộ phận đang lố ngân sách hiệu năng">
        <mxGraphModel dx="1499" dy="527" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="650" math="0" shadow="0">
            <root>
