<mxfile host="Electron" agent="5.0">
  <diagram id="008-sequence" name="Trình tự — thay đổi schema, compatibility check">
    <mxGraphModel dx="1300" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" style="text;html=1;fontStyle=1;fontSize=15;fontColor=#333333;" value="Trình tự — đề xuất thay đổi schema → compatibility check, và nhánh tolerant-reader" vertex="1">
          <mxGeometry height="26" width="1000" x="30" y="10" as="geometry" />
        </mxCell>

        <mxCell id="h_dev" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" value="Developer" vertex="1">
          <mxGeometry height="40" width="160" x="30" y="60" as="geometry" />
        </mxCell>
        <mxCell id="h_check" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" value="SchemaImmutabilityTests" vertex="1">
          <mxGeometry height="40" width="220" x="330" y="60" as="geometry" />
        </mxCell>
        <mxCell id="h_contracts" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" value="shared/EventContracts" vertex="1">
          <mxGeometry height="40" width="220" x="670" y="60" as="geometry" />
        </mxCell>

        <mxCell id="l1" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="110" y="100" as="sourcePoint" /><mxPoint x="110" y="520" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="l2" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="100" as="sourcePoint" /><mxPoint x="440" y="520" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="l3" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="780" y="100" as="sourcePoint" /><mxPoint x="780" y="520" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="a1" parent="1" style="endArrow=block;html=1;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="110" y="140" as="sourcePoint" /><mxPoint x="440" y="140" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="a1t" parent="1" style="text;html=1;fontSize=10;" value="1. Đề xuất sửa schema OrderPlaced/BasketCheckedOut" vertex="1">
          <mxGeometry height="20" width="450" x="140" y="122" as="geometry" />
        </mxCell>
        <mxCell id="a2" parent="1" style="endArrow=block;html=1;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="180" as="sourcePoint" /><mxPoint x="780" y="180" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="a2t" parent="1" style="text;html=1;fontSize=10;" value="2. So sánh với phiên bản đã công bố" vertex="1">
          <mxGeometry height="20" width="350" x="450" y="162" as="geometry" />
        </mxCell>

        <mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" value="Có phá vỡ&#xa;bên đang&#xa;nghe?" vertex="1">
          <mxGeometry height="90" width="140" x="370" y="230" as="geometry" />
        </mxCell>
        <mxCell id="a3t" parent="1" style="text;html=1;fontSize=10;fontColor=#b85450;" value="3a. Có, nhưng THIẾU version mới → compatibility check FAIL, chặn merge (SC-002)" vertex="1">
          <mxGeometry height="30" width="500" x="30" y="350" as="geometry" />
        </mxCell>
        <mxCell id="a4t" parent="1" style="text;html=1;fontSize=10;fontColor=#2d6a2d;" value="3b. Có, CÓ version mới → phiên bản cũ vẫn hoạt động trong deprecation window, PASS" vertex="1">
          <mxGeometry height="30" width="550" x="30" y="400" as="geometry" />
        </mxCell>
        <mxCell id="a5t" parent="1" style="text;html=1;fontSize=10;fontColor=#2d6a2d;" value="3c. Không phá vỡ gì (thuần additive) → PASS, không bắt buộc version mới" vertex="1">
          <mxGeometry height="30" width="550" x="30" y="450" as="geometry" />
        </mxCell>

        <mxCell id="fail_box" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef7ee;strokeColor=#82b366;fontSize=10;verticalAlign=top;align=left;spacingTop=6;" value="Nhánh: tolerant reader — consumer cũ đọc event version mới có field lạ" vertex="1">
          <mxGeometry height="70" width="1000" x="30" y="490" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
