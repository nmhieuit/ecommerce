        <mxCell id="a3t" parent="1" style="text;html=1;fontSize=9;fontColor=#666666;" value="githubNotify: PENDING -&gt; SUCCESS (x4)" vertex="1">
          <mxGeometry height="20" width="260" x="470" y="270" as="geometry" />
