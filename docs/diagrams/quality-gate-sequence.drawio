        <mxCell id="a2t" parent="1" style="text;html=1;fontSize=10;" value="2. Jenkins TỰ QUÉT phát hiện commit mới&#xa;(PeriodicFolderTrigger, mỗi 5 phút — không phải GitHub chủ động gọi Jenkins)" vertex="1">
          <mxGeometry height="30" width="400" x="470" y="160" as="geometry" />
        </mxCell>

        <mxCell id="box_run" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;fontSize=10;verticalAlign=top;align=left;spacingLeft=8;fontStyle=2;" value="3. Chạy tuần tự: build -&gt; unit test -&gt; integration test -&gt; contract test&#xa;    (mỗi bước cập nhật ngay một check tương ứng lên PR)" vertex="1">
          <mxGeometry height="60" width="240" x="680" y="220" as="geometry" />
