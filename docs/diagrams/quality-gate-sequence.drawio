            <mxPoint x="1130" y="530" as="sourcePoint" />
            <mxPoint x="440" y="530" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a8t" parent="1" style="text;html=1;fontSize=10;" value="8. Community Branch Plugin đăng comment lên PR: &quot;Quality Gate failed&quot; kèm lý do cụ thể" vertex="1">
          <mxGeometry height="20" width="600" x="470" y="512" as="geometry" />
        </mxCell>

        <mxCell id="a9" parent="1" style="endArrow=block;html=1;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
