        <mxCell id="a9t" parent="1" style="text;html=1;fontSize=10;" value="9. Nhà phát triển thấy PR bị chặn kèm lý do rõ ràng ngay tại chỗ" vertex="1">
          <mxGeometry height="20" width="330" x="150" y="572" as="geometry" />
