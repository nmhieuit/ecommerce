        <mxCell id="a4t" parent="1" style="text;html=1;fontSize=10;" value="4. dotnet sonarscanner begin/end — tải phân tích lên" vertex="1">
          <mxGeometry height="20" width="330" x="800" y="292" as="geometry" />
