        <mxCell id="a6t" parent="1" style="text;html=1;fontSize=10;" value="6. Webhook trả kết quả cổng: KHÔNG ĐẠT (ví dụ)" vertex="1">
          <mxGeometry height="20" width="330" x="800" y="382" as="geometry" />
