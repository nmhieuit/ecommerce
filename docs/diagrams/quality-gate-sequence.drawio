        <!-- Fail branch box -->
        <mxCell id="fail_box" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#b85450;fontSize=10;verticalAlign=top;align=left;spacingTop=6;" value="Nhánh: cổng chất lượng KHÔNG đạt" vertex="1">
          <mxGeometry height="220" width="1200" x="30" y="430" as="geometry" />
