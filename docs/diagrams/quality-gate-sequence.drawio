        <mxCell id="a7t" parent="1" style="text;html=1;fontSize=10;" value="7. ci/sonarqube-quality-gate = FAILURE&#xa;-&gt; GitHub tự khoá nút merge, mọi vai trò" vertex="1">
          <mxGeometry height="30" width="330" x="470" y="452" as="geometry" />
        </mxCell>

        <mxCell id="a8" parent="1" style="endArrow=block;html=1;fontSize=10;" edge="1">
