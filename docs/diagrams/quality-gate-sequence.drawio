        <mxCell id="l_sq" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1130" y="100" as="sourcePoint" />
            <mxPoint x="1130" y="1580" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 1 -->
        <mxCell id="a1" parent="1" style="endArrow=block;html=1;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="120" y="140" as="sourcePoint" />
            <mxPoint x="440" y="140" as="targetPoint" />
