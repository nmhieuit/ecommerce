        <mxCell id="a10t" parent="1" style="text;html=1;fontSize=10;" value="10. Sửa vấn đề, push commit mới vào CÙNG PR" vertex="1">
          <mxGeometry height="20" width="330" x="150" y="612" as="geometry" />
