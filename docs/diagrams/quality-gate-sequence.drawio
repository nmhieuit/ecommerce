        <mxCell id="a13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" value="13. GitHub tự mở khoá nút &quot;Merge pull request&quot;&#xa;— không cần bước duyệt thủ công nào thêm" vertex="1">
          <mxGeometry height="50" width="300" x="290" y="800" as="geometry" />
