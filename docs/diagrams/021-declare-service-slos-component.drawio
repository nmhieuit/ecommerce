                <mxCell id="manifests" value="7× service-manifest.yaml&#xa;(parties, products, baskets, orders,&#xa;identity, gateway, bff)&#xa;service.classification: internal-service-api | client-facing-bff&#xa;slos: {latency.p95, latency.p99, error-rate.max-5xx-ratio, availability}&#xa;slos.justification (tuỳ chọn — hiện chưa service nào dùng)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1">
