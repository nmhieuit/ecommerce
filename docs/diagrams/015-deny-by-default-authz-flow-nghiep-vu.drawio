<mxfile host="65bd71144e">
    <diagram id="deny-by-default-authz-flow-nghiep-vu" name="Mỗi cửa tự khai báo — từ lúc xây cửa tới lúc có người đi qua">
        <mxGraphModel dx="1820" dy="1290" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="650" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Mỗi &quot;cửa ra vào&quot; (endpoint) phải tự khai báo rõ ai được đi qua — từ lúc xây tới lúc có người đi qua" style="text;html=1;fontStyle=1;fontSize=15;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="30" y="-7" width="1300" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="lane1_label" value="Luồng 1 — Lúc xây một cửa mới (đội kỹ thuật)" style="text;html=1;fontStyle=1;fontSize=12;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="30" y="55" width="500" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="n1" value="1. Dev xây một cửa&#xa;(endpoint) mới" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="30" y="90" width="190" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="n2" value="2. Vô tình quên dán biển&#xa;&quot;ai được đi qua cửa này&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="250" y="90" width="210" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="d1" value="Thanh tra tự động&#xa;(build) kiểm tra:&#xa;đã dán biển chưa?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="510" y="75" width="170" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="n3b" value="3a. Build TỰ ĐỘNG CHẶN LẠI —&#xa;nêu rõ đúng cửa nào bị thiếu biển" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="730" y="150" width="240" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="n3a" value="3b. Build xanh — cửa được&#xa;phép đưa vào sử dụng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="730" y="20" width="240" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="n4" value="4. Dev dán biển còn thiếu&#xa;rồi nộp lại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1010" y="150" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" parent="1" source="n1" target="n2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" parent="1" source="n2" target="d1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" value="Có" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;fontColor=#2d6a2d;" parent="1" source="d1" target="n3a" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4" value="Không" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;fontColor=#b85450;" parent="1" source="d1" target="n3b" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" parent="1" source="n3b" target="n4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e6" value="nộp lại — thanh tra chạy lại" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;fontSize=9;fontColor=#666666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="n4" target="d1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1110" y="260"/>
                            <mxPoint x="680" y="260"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="lane2_label" value="Luồng 2 — Lúc có người thật sự đi qua cửa (người dùng cuối)" style="text;html=1;fontStyle=1;fontSize=12;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="30" y="300" width="500" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="m1" value="1. Người dùng đã đăng&#xa;nhập thật, gửi yêu cầu&#xa;tới một cửa cụ thể" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="30" y="340" width="220" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="d2" value="Người này có đúng&#xa;loại &quot;thẻ&quot; cửa này&#xa;yêu cầu không?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="290" y="330" width="170" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="m2a" value="2a. Yêu cầu được xử lý&#xa;bình thường" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="510" y="280" width="220" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="m2b" value="2b. Bị từ chối NGAY tại cửa,&#xa;với thông báo rõ ràng —&#xa;không phải một lỗi mơ hồ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="510" y="400" width="220" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" parent="1" source="m1" target="d2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="f2" value="Có" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;fontColor=#2d6a2d;" parent="1" source="d2" target="m2a" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="f3" value="Không" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;fontColor=#b85450;" parent="1" source="d2" target="m2b" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="note1" value="Liên hệ giữa hai luồng: &quot;tấm biển&quot; mà Luồng 1 bắt buộc phải dán rõ ràng chính là điều Luồng 2 dùng để quyết định &quot;đúng loại thẻ&quot; là gì — không có&#xa;luồng 1 (khai báo tường minh, được thanh tra tự động xác nhận), luồng 2 sẽ phải dựa vào một mặc định ẩn mà không ai nhìn thấy hoặc kiểm chứng được." style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;" parent="1" vertex="1">
                    <mxGeometry x="800" y="340" width="650" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="note2" value="Có công tắc khẩn cấp riêng cho &quot;kiểm tra đúng thẻ&quot; (Luồng 2, bước d2): nếu quy tắc mới gây sự cố, gạt công tắc để tạm quay về &quot;chỉ cần đã đăng nhập là đủ&quot;, không cần dừng hệ thống." style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;" parent="1" vertex="1">
                    <mxGeometry x="800" y="410" width="650" height="50" as="geometry"/>
                </mxCell>
            </root>
