                <mxCell id="a1t" value="1. POST /orders (KHÔNG có sẵn X-Correlation-Id)" style="text;html=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="120" y="122" width="350" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="box_gw" value="2. CorrelationIdMiddleware: không thấy header hợp lệ&#xa;    → sinh Guid mới, ghi NGƯỢC vào request.Headers&#xa;    (không chỉ response) để YARP copy đi tiếp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;fontSize=9;verticalAlign=top;align=left;spacingLeft=8;fontStyle=2;" parent="1" vertex="1">
