                        <mxPoint x="380" y="580" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="a8t" value="8. 201 Created — response echo lại X-Correlation-Id qua từng chặng" style="text;html=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="450" y="562" width="450" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="a9" style="endArrow=block;html=1;fontSize=10;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="380" y="630" as="sourcePoint"/>
                        <mxPoint x="110" y="630" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="a9t" value="9. Response header X-Correlation-Id — WithExposedHeaders(...) cho phép JS đọc được (CORS)" style="text;html=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="120" y="612" width="520" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="note" value="Kết quả: 1 mã, tra trên Elastic, thấy đủ 5 chặng (Gateway → BFF → Orders → consumer bất đồng bộ) + đúng mã hiển thị trên DevTools của trình duyệt." style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;" parent="1" vertex="1">
