                </mxCell>
                <mxCell id="a3" style="endArrow=block;html=1;fontSize=10;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="380" y="260" as="sourcePoint"/>
                        <mxPoint x="640" y="260" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="a3t" value="3. YARP forward, header copy tự động (gồm X-Correlation-Id)" style="text;html=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="390" y="242" width="400" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="box_bff" value="4. TenantPropagationHandler đọc HttpContext.Items[X-Correlation-Id]&#xa;    (giá trị CorrelationIdMiddleware của CHÍNH BFF đã quyết định),&#xa;    relay tường minh — HttpClient KHÔNG tự forward gì cả" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;fontSize=9;verticalAlign=top;align=left;spacingLeft=8;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="550" y="290" width="300" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="a5" style="endArrow=block;html=1;fontSize=10;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="640" y="400" as="sourcePoint"/>
                        <mxPoint x="900" y="400" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="a5t" value="5. POST /orders kèm X-Correlation-Id (relay tường minh)" style="text;html=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="650" y="382" width="400" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="a6" value="6. Order.PlaceFrom(...) — mọi dòng log của Orders.Api trong logging scope này tự động kèm CorrelationId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1">
