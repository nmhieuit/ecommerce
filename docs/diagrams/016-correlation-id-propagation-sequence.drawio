    <diagram id="correlation-id-propagation-sequence" name="Trình tự — mã theo dõi qua 4 chặng đồng bộ, tới sự kiện bất đồng bộ">
        <mxGraphModel dx="1232" dy="448" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="800" math="0" shadow="0">
