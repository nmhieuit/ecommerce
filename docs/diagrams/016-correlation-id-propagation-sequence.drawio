                        <mxPoint x="1170" y="510" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="a7t" value="7. OrderPlaced event — correlation ID mang theo trong payload sự kiện (không đứt khi chuyển sync→async)" style="text;html=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="910" y="492" width="480" height="30" as="geometry"/>
