<mxfile host="Electron" agent="5.0">
  <diagram id="identity-server-sequence" name="Trình tự — đăng nhập, xác thực độc lập ở mỗi lớp, và hai nhánh từ chối">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" style="text;html=1;fontStyle=1;fontSize=15;fontColor=#333333;" value="Trình tự — đăng nhập, request qua từng lớp tự xác thực độc lập, và hai nhánh từ chối" vertex="1">
          <mxGeometry height="26" width="1100" x="30" y="10" as="geometry" />
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="h_client" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" value="Client" vertex="1">
          <mxGeometry height="40" width="150" x="30" y="60" as="geometry" />
        </mxCell>
        <mxCell id="h_identity" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" value="service identity&#xa;(Duende IdentityServer)" vertex="1">
          <mxGeometry height="40" width="200" x="260" y="60" as="geometry" />
        </mxCell>
        <mxCell id="h_gw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" value="Gateway.Api" vertex="1">
          <mxGeometry height="40" width="180" x="540" y="60" as="geometry" />
        </mxCell>
        <mxCell id="h_bff" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" value="Bff.Api" vertex="1">
          <mxGeometry height="40" width="180" x="800" y="60" as="geometry" />
        </mxCell>
        <mxCell id="h_dom" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" value="Products.Api&#xa;(đại diện 4 domain service)" vertex="1">
          <mxGeometry height="40" width="220" x="1040" y="60" as="geometry" />
        </mxCell>

        <mxCell id="l_client" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="105" y="100" as="sourcePoint" />
            <mxPoint x="105" y="1460" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l_identity" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="360" y="100" as="sourcePoint" />
            <mxPoint x="360" y="1460" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l_gw" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="630" y="100" as="sourcePoint" />
            <mxPoint x="630" y="1460" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l_bff" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="890" y="100" as="sourcePoint" />
            <mxPoint x="890" y="1460" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l_dom" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1150" y="100" as="sourcePoint" />
            <mxPoint x="1150" y="1460" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Happy path -->
        <mxCell id="a1" parent="1" style="endArrow=block;html=1;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="105" y="140" as="sourcePoint" />
            <mxPoint x="360" y="140" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a1t" parent="1" style="text;html=1;fontSize=10;" value="1. Đăng nhập (username/password)" vertex="1">
          <mxGeometry height="20" width="240" x="120" y="122" as="geometry" />
        </mxCell>

        <mxCell id="a2" parent="1" style="endArrow=block;html=1;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="360" y="180" as="sourcePoint" />
            <mxPoint x="105" y="180" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a2t" parent="1" style="text;html=1;fontSize=10;" value="2. Token (JWT RS256) — claim sub + tenant_id, phát hành bởi TenantClaimsProfileService" vertex="1">
          <mxGeometry height="20" width="450" x="120" y="162" as="geometry" />
        </mxCell>

        <mxCell id="a3" parent="1" style="endArrow=block;html=1;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="105" y="220" as="sourcePoint" />
            <mxPoint x="630" y="220" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a3t" parent="1" style="text;html=1;fontSize=10;" value="3. Request kèm Authorization: Bearer &lt;token&gt;" vertex="1">
          <mxGeometry height="20" width="350" x="150" y="202" as="geometry" />
        </mxCell>

        <mxCell id="box_gw" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;fontSize=9;verticalAlign=top;align=left;spacingLeft=8;fontStyle=2;" value="4. Gateway tự fetch JWKS &amp; xác thực&#xa;    (theo toggle: JwtBearer hoặc&#xa;    StubIdentityAuthenticationHandler)" vertex="1">
          <mxGeometry height="60" width="180" x="540" y="250" as="geometry" />
        </mxCell>

        <mxCell id="a5" parent="1" style="endArrow=block;html=1;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="630" y="330" as="sourcePoint" />
            <mxPoint x="890" y="330" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a5t" parent="1" style="text;html=1;fontSize=10;" value="5. Forward Authorization header nguyên vẹn (YARP)" vertex="1">
          <mxGeometry height="20" width="330" x="650" y="312" as="geometry" />
        </mxCell>

        <mxCell id="box_bff" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;fontSize=9;verticalAlign=top;align=left;spacingLeft=8;fontStyle=2;" value="6. BFF tự fetch JWKS &amp; tự xác thực&#xa;    LẠI cùng token — KHÔNG tin&#xa;    gateway đã xác thực" vertex="1">
          <mxGeometry height="60" width="180" x="800" y="360" as="geometry" />
        </mxCell>

        <mxCell id="a7" parent="1" style="endArrow=block;html=1;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="890" y="440" as="sourcePoint" />
            <mxPoint x="1150" y="440" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a7t" parent="1" style="text;html=1;fontSize=10;" value="7. Forward Authorization header (TenantPropagationHandler)" vertex="1">
          <mxGeometry height="20" width="350" x="900" y="422" as="geometry" />
        </mxCell>

        <mxCell id="box_dom" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;fontSize=9;verticalAlign=top;align=left;spacingLeft=8;fontStyle=2;" value="8. Domain service tự fetch JWKS&#xa;    &amp; tự xác thực LẠI — không tin&#xa;    gateway lẫn BFF" vertex="1">
          <mxGeometry height="60" width="200" x="1040" y="470" as="geometry" />
        </mxCell>

        <mxCell id="a9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" value="9. Token Valid ở cả 3 lớp — xử lý request, tenant_id/sub dùng đúng như trước (nguồn đổi, cơ chế lan truyền không đổi)" vertex="1">
          <mxGeometry height="40" width="1200" x="30" y="550" as="geometry" />
        </mxCell>

        <!-- Branch: tampered token, bypass gateway -->
        <mxCell id="fail_box1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#b85450;fontSize=10;verticalAlign=top;align=left;spacingTop=6;" value="Nhánh A — Token giả mạo, gửi THẲNG tới domain service, bỏ qua gateway VÀ BFF hoàn toàn (spec US2 Test Scenario 2)" vertex="1">
          <mxGeometry height="140" width="1200" x="30" y="620" as="geometry" />
        </mxCell>
        <mxCell id="b1" parent="1" style="endArrow=block;html=1;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="105" y="670" as="sourcePoint" />
            <mxPoint x="1150" y="670" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="b1t" parent="1" style="text;html=1;fontSize=10;" value="A1. Request tới Products.Api trực tiếp, kèm token đã chỉnh sửa chữ ký" vertex="1">
          <mxGeometry height="20" width="500" x="200" y="652" as="geometry" />
        </mxCell>
        <mxCell id="b2" parent="1" style="endArrow=block;html=1;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1150" y="720" as="sourcePoint" />
            <mxPoint x="105" y="720" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="b2t" parent="1" style="text;html=1;fontSize=10;" value="A2. 401 — Products.Api tự phát hiện chữ ký sai và từ chối, KHÔNG cần gateway đã chặn từ trước" vertex="1">
          <mxGeometry height="20" width="700" x="200" y="702" as="geometry" />
        </mxCell>

        <!-- Branch: expired token -->
        <mxCell id="fail_box2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#b85450;fontSize=10;verticalAlign=top;align=left;spacingTop=6;" value="Nhánh B — Token đã hết hạn (spec US3), gửi qua gateway như luồng bình thường" vertex="1">
          <mxGeometry height="140" width="1200" x="30" y="780" as="geometry" />
        </mxCell>
        <mxCell id="c1" parent="1" style="endArrow=block;html=1;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="105" y="830" as="sourcePoint" />
            <mxPoint x="630" y="830" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c1t" parent="1" style="text;html=1;fontSize=10;" value="B1. Request kèm token đã qua exp + ClockSkew mặc định 5 phút" vertex="1">
          <mxGeometry height="20" width="450" x="150" y="812" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="endArrow=block;html=1;fontSize=10;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="630" y="880" as="sourcePoint" />
            <mxPoint x="105" y="880" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c2t" parent="1" style="text;html=1;fontSize=10;" value="B2. 401 {&quot;error&quot;:&quot;token_expired&quot;,&quot;message&quot;:&quot;The bearer token has expired.&quot;} — ClearUnauthorizedResponseEvents, không phải 401 rỗng mặc định" vertex="1">
          <mxGeometry height="30" width="750" x="150" y="862" as="geometry" />
        </mxCell>
        <mxCell id="c3t" parent="1" style="text;html=1;fontSize=9;fontColor=#666666;" value="Cùng cơ chế áp dụng ở BẤT KỲ lớp nào nhận token hết hạn đầu tiên — gateway (nếu toggle ON), BFF, hoặc domain service." vertex="1">
          <mxGeometry height="20" width="700" x="150" y="900" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
