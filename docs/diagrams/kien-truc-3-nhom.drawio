        </mxCell>
        <mxCell id="note1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9;dashed=1;" value="Gateway gắn X-Tenant-Id, X-Subject-Id (danh tính giả lập) + X-Correlation-Id">
