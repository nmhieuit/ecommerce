<mxfile host="Electron" agent="5.0">
  <diagram id="004-minimal-shopping-spa-flow" name="Luồng mua sắm — duyệt, giỏ hàng, thanh toán, xác nhận">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" style="text;html=1;fontStyle=1;fontSize=16;fontColor=#333333;" value="Luồng mua sắm tối thiểu — duyệt sản phẩm → giỏ hàng → thanh toán → xác nhận" vertex="1">
          <mxGeometry height="30" width="1100" x="30" y="20" as="geometry" />
        </mxCell>

        <mxCell id="n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="1. Duyệt sản phẩm&#xa;GET /bff/products&#xa;(hoặc trạng thái &quot;chưa có&#xa;sản phẩm&quot; nếu rỗng)" vertex="1">
          <mxGeometry height="100" width="220" x="30" y="90" as="geometry" />
        </mxCell>

        <mxCell id="n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="2. Thêm vào giỏ hàng&#xa;POST /bff/baskets/items&#xa;(gộp số lượng nếu đã có&#xa;— không tạo dòng mới)" vertex="1">
          <mxGeometry height="100" width="220" x="310" y="90" as="geometry" />
        </mxCell>

        <mxCell id="n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="Giỏ hàng lưu ở BACKEND&#xa;(không phải trình duyệt)&#xa;— sống sót qua refresh /&#xa;đóng-mở lại trình duyệt" vertex="1">
          <mxGeometry height="90" width="220" x="310" y="220" as="geometry" />
        </mxCell>

        <mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" value="Giỏ hàng&#xa;có trống?" vertex="1">
          <mxGeometry height="90" width="140" x="600" y="95" as="geometry" />
        </mxCell>

        <mxCell id="n4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" value="Chặn NGAY tại giao diện&#xa;— không gửi request nào" vertex="1">
          <mxGeometry height="70" width="200" x="600" y="220" as="geometry" />
        </mxCell>

        <mxCell id="n5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="3. Thanh toán&#xa;POST /bff/orders&#xa;(BFF điều phối 2 bước —&#xa;không tự tính tổng tiền)" vertex="1">
          <mxGeometry height="100" width="220" x="820" y="90" as="geometry" />
        </mxCell>

        <mxCell id="n6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="4. Màn hình xác nhận&#xa;— mã đơn hàng + tổng tiền&#xa;— giỏ hàng trở về trống" vertex="1">
          <mxGeometry height="100" width="220" x="1090" y="90" as="geometry" />
        </mxCell>

        <mxCell id="note1" parent="1" style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;" value="Thanh toán liên tiếp nhiều lần chỉ tạo ĐÚNG MỘT đơn hàng (nút bị vô hiệu hoá trong lúc yêu cầu đang xử lý).&#xa;Mọi lỗi backend (mất kết nối, chậm...) hiển thị thông báo rõ ràng trong vòng 5 giây, giỏ hàng KHÔNG bị mất nếu thanh toán thất bại." vertex="1">
          <mxGeometry height="40" width="1000" x="30" y="380" as="geometry" />
        </mxCell>

        <mxCell id="e1" edge="1" parent="1" source="n1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" target="n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="n2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" target="n3" value="ghi vào">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="n2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="d1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;fontColor=#b85450;" target="n4" value="Có">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="d1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;fontColor=#2d6a2d;" target="n5" value="Không">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="n5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" target="n6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
