<mxfile host="Electron" agent="5.0">
  <diagram id="001-scaffold-service-shells-flow-nghiep-vu" name="Mỗi mảng nghiệp vụ có nhà riêng">
    <mxGraphModel dx="1300" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="450" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" style="text;html=1;fontStyle=1;fontSize=16;fontColor=#333333;" value="Mỗi mảng nghiệp vụ có &quot;nhà riêng&quot; — không chia sẻ dữ liệu với ai" vertex="1">
          <mxGeometry height="30" width="900" x="30" y="20" as="geometry" />
        </mxCell>

        <mxCell id="n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="1. Bốn mảng nghiệp vụ&#xa;(khách hàng, sản phẩm,&#xa;giỏ hàng, đơn hàng)" vertex="1">
          <mxGeometry height="90" width="220" x="30" y="90" as="geometry" />
        </mxCell>

        <mxCell id="n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="2. Mỗi mảng có kho dữ liệu&#xa;RIÊNG — không mảng nào&#xa;chạm được dữ liệu mảng khác" vertex="1">
          <mxGeometry height="90" width="240" x="320" y="90" as="geometry" />
        </mxCell>

        <mxCell id="n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="3. Một người có thể chạy&#xa;đúng MỘT mảng để làm việc&#xa;— không cần dựng cả 4" vertex="1">
          <mxGeometry height="90" width="240" x="640" y="90" as="geometry" />
        </mxCell>

        <mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="Kho dữ liệu&#xa;riêng kết nối&#xa;được?" vertex="1">
          <mxGeometry height="110" width="150" x="960" y="80" as="geometry" />
        </mxCell>

        <mxCell id="n4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="4a. Báo &quot;sẵn sàng&quot;" vertex="1">
          <mxGeometry height="60" width="180" x="1180" y="60" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" value="4b. Báo trung thực&#xa;&quot;chưa sẵn sàng&quot;" vertex="1">
          <mxGeometry height="70" width="180" x="1180" y="150" as="geometry" />
        </mxCell>

        <mxCell id="note" parent="1" style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;" value="Ranh giới &quot;kho riêng&quot; đã được kiểm chứng thật: đội cố tình để một mảng tìm cách chạm dữ liệu mảng khác và xác nhận&#xa;không có đường nào cho phép — zero ngoại lệ (không phải thiết kế trên giấy)." vertex="1">
          <mxGeometry height="40" width="1000" x="30" y="260" as="geometry" />
        </mxCell>

        <mxCell id="e1" edge="1" parent="1" source="n1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" target="n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="n2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" target="n3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="n3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="d1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;fontColor=#2d6a2d;" target="n4" value="Có">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="d1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;fontColor=#b85450;" target="n5" value="Không">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
