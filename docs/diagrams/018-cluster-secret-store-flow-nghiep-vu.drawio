<mxfile host="65bd71144e">
    <diagram id="cluster-secret-store-flow-nghiep-vu" name="Từ chối chạy nếu thiếu mật khẩu — thay vì âm thầm lỗi sau này">
        <mxGraphModel dx="1699" dy="527" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="600" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Một service khởi động — từ chối chạy nếu thiếu mật khẩu, thay vì âm thầm lỗi khi có khách hàng đầu tiên" style="text;html=1;fontStyle=1;fontSize=16;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="30" y="20" width="1150" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="n1" value="1. Bộ phận bắt đầu khởi động" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="100" width="220" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="d1" value="Đã nhận được&#xa;mật khẩu thật chưa?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="310" y="80" width="200" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="n2a" value="2a. Khởi động thành công,&#xa;kết nối cơ sở dữ liệu bình thường" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="580" y="30" width="260" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="n2b" value="2b. DỪNG NGAY LẬP TỨC — báo lỗi rõ&#xa;ràng tên mật khẩu còn thiếu, KHÔNG&#xa;bao giờ chạy lên rồi lỗi sau" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="580" y="140" width="260" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="n3" value="3a. Phục vụ khách hàng bình thường" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="900" y="40" width="260" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n4" value="3b. Đội vận hành thấy lỗi ngay lúc&#xa;triển khai — sửa cấu hình rồi triển&#xa;khai lại, KHÔNG có khách hàng nào&#xa;từng chạm phải lỗi mơ hồ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="900" y="140" width="260" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="note" value="So sánh với cách làm cũ: file cấu hình từng chứa mật khẩu thẳng trong đó (rủi ro rò rỉ) — giờ file không còn giá trị thật nào, mật khẩu chỉ được cấp lúc chạy." style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;" parent="1" vertex="1">
                    <mxGeometry x="30" y="280" width="700" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="note2" value="Song song: mỗi thay đổi mã nguồn gửi lên đều bị quét tự động tìm dấu vết mật khẩu bị lộ — cả trong lịch sử git lẫn trong image đã đóng gói." style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;" parent="1" vertex="1">
                    <mxGeometry x="770" y="280" width="500" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" parent="1" source="n1" target="d1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2a" value="Rồi" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;fontColor=#2d6a2d;" parent="1" source="d1" target="n2a" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2b" value="Chưa" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;fontColor=#b85450;" parent="1" source="d1" target="n2b" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" parent="1" source="n2a" target="n3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
