        </mxCell>
        <mxCell id="bff_valid" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" value="AddIdentityValidation()&#xa;TỰ xác thực độc lập — KHÔNG tin&#xa;gateway đã xác thực" vertex="1">
