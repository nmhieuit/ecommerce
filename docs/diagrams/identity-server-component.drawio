        <mxCell id="note" parent="1" style="text;html=1;fontSize=10;fontColor=#b85450;whiteSpace=wrap;align=left;" value="Nguyên lý xuyên suốt (constitution Principle VI): gateway KHÔNG phải ranh giới tin cậy các service khác dựa vào. BFF và mỗi&#xa;domain service tự fetch JWKS của chính mình từ service identity và tự xác thực lại cùng token gốc — không tin bất kỳ ai đã&#xa;&quot;xử lý xong hộ&quot;. Toggle ở gateway chỉ kiểm soát lớp xác thực CỦA RIÊNG gateway (xem docs/architecture/identity-server-architecture.md mục 4)." vertex="1">
          <mxGeometry height="60" width="1250" x="30" y="510" as="geometry" />
        </mxCell>

        <mxCell id="e_login" edge="1" parent="1" source="client" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;exitX=0.75;exitY=0;entryX=0.15;entryY=1;" target="identity_api" value="1. Đăng nhập&#xa;(ROPC test client — UI thật chưa xây, mục 6)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_request" edge="1" parent="1" source="client" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" target="gw_grp" value="2. Request kèm&#xa;Authorization: Bearer &lt;token&gt;">
