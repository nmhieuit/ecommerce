<mxfile host="65bd71144e">
    <diagram id="liveness-readiness-probes-flow-nghiep-vu" name="2 câu hỏi sức khoẻ tách biệt — sẵn sàng vs còn sống">
        <mxGraphModel dx="1232" dy="1110" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="650" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Một pod trong vòng đời của nó — 2 câu hỏi sức khoẻ tách biệt, Kubernetes tự hành động theo từng câu" style="text;html=1;fontStyle=1;fontSize=15;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="30" y="-10" width="1150" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="n1" value="1. Pod mới được tạo&#xa;(triển khai lần đầu hoặc&#xa;rolling update)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="90" width="220" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="d1" value="Readiness probe&#xa;(&quot;sẵn sàng nhận&#xa;khách chưa?&quot;) pass?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="310" y="70" width="200" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="n2a" value="2a. Nhận traffic bình thường —&#xa;pod cũ (nếu là rolling update) vẫn&#xa;phục vụ song song cho tới khi bị thay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="570" y="30" width="280" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="n2b" value="2b. TẠM KHÔNG nhận traffic nào&#xa;— ví dụ đang chờ kết nối cơ sở&#xa;dữ liệu (chưa phải &quot;chết&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="570" y="150" width="280" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="d2" value="Liveness probe&#xa;(&quot;còn sống&#xa;không?&quot;) pass?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="900" y="130" width="200" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="n3a" value="3a. Tiếp tục chờ, thử lại theo chu kỳ&#xa;— không bị khởi động lại nhầm chỉ vì&#xa;1 dependency ngoài đang chậm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1140" y="100" width="260" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="n3b" value="3b. Vượt ngưỡng lỗi liên tiếp —&#xa;Kubernetes TỰ KHỞI ĐỘNG LẠI pod,&#xa;không cần người trực đêm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1140" y="220" width="260" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="note" value="Tách biệt có chủ đích: nếu trộn 2 câu hỏi làm 1, sự cố tạm thời của cơ sở dữ liệu sẽ khiến Kubernetes hiểu nhầm pod &quot;đã chết&quot; và khởi động lại nó — trong khi tiến trình vẫn hoàn toàn khoẻ mạnh." style="text;html=1;fontSize=10;fontColor=#666666;whiteSpace=wrap;align=left;" parent="1" vertex="1">
                    <mxGeometry x="310" y="350" width="850" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" parent="1" source="n1" target="d1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2a" value="Có" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;fontColor=#2d6a2d;" parent="1" source="d1" target="n2a" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2b" value="Chưa" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;fontColor=#d6b656;" parent="1" source="d1" target="n2b" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" parent="1" source="n2b" target="d2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4a" value="Có" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;fontColor=#2d6a2d;" parent="1" source="d2" target="n3a" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4b" value="Không (treo/deadlock)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;fontColor=#b85450;" parent="1" source="d2" target="n3b" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;fontSize=9;" parent="1" source="n3a" target="d1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1270" y="20"/>
                            <mxPoint x="410" y="20"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
