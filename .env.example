# Copy this file to .env (gitignored) before running docker-compose.yml/docker-compose.local.yml.
# Local development only — never a production secret path (constitution Principle VI:
# real secrets are injected at runtime from the cluster secret store, not files like this one).
#
# File chia 2 vùng:
#   VÙNG 1 — BIẾN THƯỜNG: host, port, user, tên database, URL, client/feature toggle… Mọi biến ở vùng
#            này đều có default y hệt trong file compose, nên xoá 1 dòng vẫn chạy như cũ.
#   VÙNG 2 — BIẾN BẢO MẬT: password, client secret… Ở môi trường thật các biến này do Key Vault cấp;
#            giá trị dưới đây chỉ dành cho Docker Desktop trên máy local.
# `cp .env.example .env` là đủ để chạy, không cần sửa gì.

# ================================================================================================
# VÙNG 1 — BIẾN THƯỜNG (không bảo mật)
# ================================================================================================

# ---------------------------------------------------------------- SQL Server
# Thành phần connection string của mọi service (ghép với MSSQL_SA_PASSWORD ở Vùng 2).
# SQLSERVER_USER phải giữ là `sa` chừng nào MSSQL_SA_PASSWORD còn là mật khẩu duy nhất của server.
SQLSERVER_USER=sa
SQLSERVER_CONNECTION_OPTIONS=TrustServerCertificate=true
# docker-compose.yml: 1 SQL Server chung cho mọi database.
SQLSERVER_HOST=sqlserver
# docker-compose.local.yml: 1 SQL Server riêng cho từng service.
PRODUCTS_DB_HOST=products-db
BASKETS_DB_HOST=baskets-db
ORDERS_DB_HOST=orders-db
PARTIES_DB_HOST=parties-db
IDENTITY_DB_HOST=identity-db
# docker-compose.local.yml: nối thêm vào connection string của các *-api để /health/ready trả 503
# trong vài giây khi database bị dừng (thay vì chờ 15 giây mặc định của driver).
SQLSERVER_FAIL_FAST_OPTIONS=Connect Timeout=3;ConnectRetryCount=0
# Tên database — dùng chung cho cả 2 file compose.
PRODUCTS_DB_NAME=products
BASKETS_DB_NAME=baskets
ORDERS_DB_NAME=orders
PARTIES_DB_NAME=parties
IDENTITY_DB_NAME=identity

# ---------------------------------------------------------------- RabbitMQ
# User tạo lúc khởi tạo broker (RABBITMQ_DEFAULT_USER) và dùng trong connection string của orders-api.
# Khớp rabbitmqUser trong postman/local.postman_environment.v2.json.
RABBITMQ_USER=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# ---------------------------------------------------------------- Identity
# Authority mọi service kiểm tra token VÀ IssuerUri của identity-api — 1 biến cho cả 2 vì chúng phải
# trùng nhau, lệch là 401 ở mọi nơi.
IDENTITY_AUTHORITY=http://identity-api:8080
# Đăng ký client đăng nhập bằng form của storefront (Config.SpaPasswordClient). Chỉ cho stack local.
IDENTITY_SPA_PASSWORD_CLIENT_ENABLED=true

# ---------------------------------------------------------------- Địa chỉ nội bộ (trong network compose)
# BFF gọi 4 domain service; gateway (YARP) chuyển tiếp tới BFF. docker-compose.local.yml và
# docker-compose.debug.yml dùng; docker-compose.yml lấy từ appsettings.json.
PRODUCTS_API_URL=http://products-api:8080
BASKETS_API_URL=http://baskets-api:8080
ORDERS_API_URL=http://orders-api:8080
PARTIES_API_URL=http://parties-api:8080
BFF_API_URL=http://bff-api:8080
# ASPNETCORE_ENVIRONMENT của các *-api trong docker-compose.local.yml (docker-compose.yml chạy Production).
LOCAL_ASPNETCORE_ENVIRONMENT=Development

# ---------------------------------------------------------------- Địa chỉ phía trình duyệt (host)
# Origin gateway cho phép gọi (CORS). VITE_DEV chỉ docker-compose.local.yml dùng (`pnpm dev`).
CORS_ORIGIN_STOREFRONT=http://localhost:4173
CORS_ORIGIN_VITE_DEV=http://localhost:5173
# Build arg của storefront — Vite nhúng vào image lúc build, đổi xong phải build lại storefront.
STOREFRONT_GATEWAY_ORIGIN=http://localhost:5300
STOREFRONT_IDENTITY_ORIGIN=http://localhost:5205

# ---------------------------------------------------------------- Quan sát (OTel / Elastic)
OTEL_COLLECTOR_ENDPOINT=http://otel-collector:4317
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# ---------------------------------------------------------------- Công tắc (feature toggle)
# Feature toggles for both docker-compose.yml and docker-compose.local.yml. Optional: left unset,
# both default to true (on). Change one, then `docker compose -f <file> up -d` recreates only the
# services it reaches. These outrank every appsettings*.json, including a live edit inside a
# running container.
#   FEATURE_IDENTITY_SERVER_AUTH_CUTOVER    gateway only (014): false = back to the Phase 1 stub
#   FEATURE_AUTHORIZATION_REQUIRE_API_SCOPE gateway, bff, products, baskets, orders, parties (015)
# Never pair cutover=false with scope=true: the stub principal has no scope claim, so the gateway
# answers 403 to every request. To roll the cutover back, set both to false.
# FEATURE_IDENTITY_SERVER_AUTH_CUTOVER=true
# FEATURE_AUTHORIZATION_REQUIRE_API_SCOPE=true

# Công tắc kết nối RabbitMQ của orders-api (024 outbox → 008 event schema). Cho cả 2 file compose.
#   docker-compose.local.yml: mặc định TRỐNG = TẮT (outbox không giao được); bỏ comment dòng dưới để BẬT.
#   docker-compose.yml:       mặc định BẬT (tự ghép từ RABBITMQ_*); đặt ORDERS_RABBITMQ_CONNECTION= (rỗng) để TẮT.
# Dòng mẫu để BẬT nằm ở CUỐI file (sau Vùng 2): .env đọc tuần tự, giá trị cần RABBITMQ_PASSWORD đã khai báo trước.
# Đổi xong: docker compose -f <file> up -d --force-recreate orders-api

# Công tắc mô phỏng "thiếu secret" (spec 018): ghi đè connection string của từng API service. Mặc định (không khai báo) = chuỗi có Password=${MSSQL_SA_PASSWORD}.
# Đặt 1 chuỗi CHỈ có host/database (không Password=, Pwd=, Integrated Security=true) thì service phải TỪ CHỐI khởi động, thông báo nêu đích danh khoá thiếu:
#   ORDERS_DB_CONNECTION=Server=orders-db;Database=orders;TrustServerCertificate=true      (tương tự PRODUCTS_/BASKETS_/PARTIES_/IDENTITY_DB_CONNECTION)
# Đổi xong: docker compose -f <file> up -d --force-recreate <service>-api

# Công tắc tiêm độ trễ chaos của orders-api (spec 025). Mặc định false = TẮT: header X-Chaos-Latency-Ms bị bỏ qua.
# Đặt true để BẬT (chỉ để diễn tập chaos trên máy local/cụm chẩn đoán, KHÔNG BAO GIỜ ở môi trường thật). Cho cả 2 file compose.
# Đổi xong: docker compose -f <file> up -d --force-recreate --no-deps orders-api
# CHAOS_ALLOW_LATENCY_INJECTION=true

# Công tắc tiêm lỗi 5xx của cả 7 *-api (spec 027, SCRUM-35 — làm cạn ngân sách lỗi có chủ đích qua đường OTel thật).
# Mặc định false = TẮT: header X-Chaos-Fault bị bỏ qua. Đặt true CHỈ trong lúc diễn tập (specs/027-error-budget-alerting/quickstart.md),
# KHÔNG BAO GIỜ ở môi trường thật; diễn tập xong đặt lại false. Cho cả 2 file compose.
# Đổi xong: docker compose -f <file> up -d --force-recreate --no-deps <service>-api
# CHAOS_ALLOW_FAULT_INJECTION=true

# ================================================================================================
# VÙNG 2 — BIẾN BẢO MẬT (môi trường thật: cấp từ Key Vault, KHÔNG để trong file)
# ================================================================================================
# Tên secret đề xuất trên Key Vault ghi ở cuối mỗi dòng mô tả.

# Mật khẩu `sa` của mọi SQL Server. Bắt buộc — thiếu thì compose dừng ngay.   [kv: ecommerce--mssql-sa-password]
MSSQL_SA_PASSWORD=Change_Me_Local_Dev_Only!

# Mật khẩu RabbitMQ của RABBITMQ_USER. Bắt buộc. Khớp rabbitmqPassword trong Postman.   [kv: ecommerce--rabbitmq-password]
# Chỉ áp dụng khi volume RabbitMQ còn trống; đổi giá trị với volume cũ thì phải `down -v` rabbitmq.
RABBITMQ_PASSWORD=guest

# Both optional (services/identity/src/Identity.Api/Data/SeedData.cs and
# TestUserPasswordProvisioning.cs fall back safely if either is blank/absent — see those files'
# remarks). Filled in here, matching postman/local.postman_environment.v2.json's checked-in
# tokenClientSecret/testPassword, so `cp .env.example .env` alone is enough for that collection's
# "01 Lấy access token" request to work with no further setup.
#   ClientSecret      [kv: ecommerce--identity-client-secret]
#   TestUserPassword  [kv: ecommerce--identity-test-user-password]
ClientSecret=integration-test-secret
TestUserPassword=Postman-Test-P@ssw0rd!

# Khoá mã hoá saved objects của Kibana (xpack.encryptedSavedObjects.encryptionKey), dài tối thiểu 32 ký tự.
# Bắt buộc — thiếu thì compose dừng ngay; không có khoá này Kibana Alerting không cho tạo/chạy rule
# cảnh báo ngân sách lỗi (spec 027, SCRUM-35). Đổi giá trị thì mọi rule/connector đã lưu phải tạo lại.   [kv: ecommerce--kibana-encryption-key]
KIBANA_ENCRYPTION_KEY=Change_Me_Local_Dev_Only_Kibana_Key_32+

# Công tắc RabbitMQ của orders-api (mô tả ở Vùng 1). Phải đứng SAU RABBITMQ_PASSWORD vì .env đọc tuần tự.
# ORDERS_RABBITMQ_CONNECTION=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}
