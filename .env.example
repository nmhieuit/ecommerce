# Copy this file to .env (gitignored) before running docker-compose.yml/docker-compose.local.yml.
# Local development only — never a production secret path (constitution Principle VI:
# real secrets are injected at runtime from the cluster secret store, not files like this one).
MSSQL_SA_PASSWORD=Change_Me_Local_Dev_Only!

# Both optional (services/identity/src/Identity.Api/Data/SeedData.cs and
# TestUserPasswordProvisioning.cs fall back safely if either is blank/absent — see those files'
# remarks). Filled in here, matching postman/local.postman_environment.v2.json's checked-in
# tokenClientSecret/testPassword, so `cp .env.example .env` alone is enough for that collection's
# "01 Lấy access token" request to work with no further setup.
ClientSecret=integration-test-secret
TestUserPassword=Postman-Test-P@ssw0rd!

# Feature toggles for both docker-compose.yml and docker-compose.local.yml. Optional: left unset,
# both default to true (on). Change one, then `docker compose -f <file> up -d` recreates only the
# services it reaches. These outrank every appsettings*.json, including a live edit inside a
# running container.
#   FEATURE_IDENTITY_SERVER_AUTH_CUTOVER    gateway only (014): false = back to the Phase 1 stub
#   FEATURE_AUTHORIZATION_REQUIRE_API_SCOPE gateway, bff, products, baskets, orders, parties (015)
# Never pair cutover=false with scope=true: the stub principal has no scope claim, so the gateway
# answers 403 to every request. To roll the cutover back, set both to false.
# FEATURE_IDENTITY_SERVER_AUTH_CUTOVER=true
# FEATURE_AUTHORIZATION_REQUIRE_API_SCOPE=true

# Công tắc kết nối RabbitMQ của orders-api (024 outbox → 008 event schema). Cho cả 2 file compose.
#   docker-compose.local.yml: mặc định TRỐNG = TẮT (outbox không giao được); đặt amqp://guest:guest@rabbitmq:5672 để BẬT.
#   docker-compose.yml:       mặc định BẬT; đặt ORDERS_RABBITMQ_CONNECTION= (rỗng) để TẮT.
# Đổi xong: docker compose -f <file> up -d --force-recreate orders-api
# ORDERS_RABBITMQ_CONNECTION=amqp://guest:guest@rabbitmq:5672
