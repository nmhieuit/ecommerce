{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "generate": {
      "cache": false,
      "outputs": ["src/generated/**"]
    },

    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },

    "dev": {
      "cache": false,
      "persistent": true
    },

    "typecheck": {
      "dependsOn": ["^build"]
    },

    "lint": {},

    "test": {
      "dependsOn": ["^build"]
    },

    "size": {
      "dependsOn": ["build"]
    },

    "e2e": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
