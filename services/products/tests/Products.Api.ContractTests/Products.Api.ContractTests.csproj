<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The provider side: this service's own build verifies its real responses against the
       consumer's committed pact (011-consumer-contract-tests FR-001..FR-006).
       Testcontainers.MsSql is here for the same reason the integration suite has it - this
       service's DbContext is registered against SQL Server and gated on a resolved tenant, so
       there is no in-memory substitute that would still be exercising real behaviour
       (constitution Principle III). -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="PactNet" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Products.Api\Products.Api.csproj" />
    <!-- 015-deny-by-default-authz: the provider host now needs to accept an authenticated,
         in-scope caller (AuthorizationPolicies.ApiScope) without a real identity server
         (011-consumer-contract-tests QA_Debt entry, resolved) — same helper every
         *.Api.IntegrationTests project already uses. -->
    <ProjectReference Include="..\..\..\..\shared\IntegrationTestSupport\IntegrationTestSupport.csproj" />
  </ItemGroup>

</Project>
