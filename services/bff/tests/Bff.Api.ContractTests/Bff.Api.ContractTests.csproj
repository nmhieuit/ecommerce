<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The consumer side of every BFF-facing HTTP boundary. Pact's mock provider stands in for the
       downstream service here, so this project needs no host and no database — it only needs the
       BFF's own downstream client types, which are what define the shape being claimed. -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="PactNet" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Referenced so the pacts are written against the very records the BFF deserialises into
       (ProductResource, BasketResource, OrderResource) rather than a copy that can drift. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Bff.Api\Bff.Api.csproj" />
    <!-- 015-deny-by-default-authz: every downstream boundary now needs an authenticated,
         in-scope caller (AuthorizationPolicies.ApiScope). TestJwtBearer.CreateToken mints one
         without a real identity server (011-consumer-contract-tests QA_Debt entry, resolved). -->
    <ProjectReference Include="..\..\..\..\shared\IntegrationTestSupport\IntegrationTestSupport.csproj" />
  </ItemGroup>

</Project>
