<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\shared\ServiceDefaults\ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native OpenAPI document generation (research.md Decision 6 / ADR-0003), which ADR-0004's
         Orval codegen pipeline consumes. Not in the shared framework — needs referencing. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Supplies AddStandardResilienceHandler(): the timeout + retry + circuit-breaker pipeline
         every outbound call is wrapped in, so no unbounded wait can exist (constitution
         Principle VIII; research.md Decision 3). -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <!-- No health-check package reference: Microsoft.Extensions.Diagnostics.HealthChecks ships in the
       ASP.NET Core shared framework, and the EF Core integration the domain services pull in
       (AddDbContextCheck<T>) has nothing to check here — the BFF owns no database. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The response-shaping functions are internal because nothing outside this service should
         call them, but they are the one piece of logic the BFF actually owns (everything else is
         proxying), so they are worth testing directly rather than only through HTTP. -->
    <InternalsVisibleTo Include="Bff.Api.UnitTests" />
  </ItemGroup>

</Project>
