{
  "Services": {
    "ProductsApi": {
      "BaseUrl": "http://products-api:8080"
    },
    "BasketsApi": {
      "BaseUrl": "http://baskets-api:8080"
    },
    "OrdersApi": {
      "BaseUrl": "http://orders-api:8080"
    },
    "PartiesApi": {
      "BaseUrl": "http://parties-api:8080"
    }
  },
  "Identity": {
    "Authority": "http://identity-api:8080",
    "Audience": "ecommerce-api"
  },
  "//FeatureToggles": "015-deny-by-default-authz, research.md Decision 5 / constitution Principle X. Off by default — the safe rollback state — until confirmed stable.",
  "FeatureToggles": {
    "AuthorizationRequireApiScope": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
