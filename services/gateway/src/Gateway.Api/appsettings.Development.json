{
  "//Cors": "The Vite dev server's origin. Local development serves the storefront separately from the gateway, so the browser treats every call as cross-origin.",
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173"]
  },
  "ReverseProxy": {
    "Clusters": {
      "bff-cluster": {
        "Destinations": {
          "bff": {
            "Address": "http://localhost:5301"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
