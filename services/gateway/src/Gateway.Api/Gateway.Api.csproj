<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\shared\ServiceDefaults\ServiceDefaults.csproj" />
  </ItemGroup>

  <!-- No health-check package reference: Microsoft.Extensions.Diagnostics.HealthChecks ships in the
       ASP.NET Core shared framework, and the EF Core integration the domain services pull in
       (AddDbContextCheck<T>) has nothing to check here — the gateway owns no database. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
