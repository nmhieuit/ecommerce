{
  "//StubIdentity": "Phase 1's single hardcoded tenant and fake user (spec FR-008), standing in for the identity server SCRUM-23 will introduce. TenantId doubles as each domain service's database schema name, so it must stay a valid SQL identifier.",
  "StubIdentity": {
    "TenantId": "contoso",
    "SubjectId": "phase1-stub-user"
  },
  "ReverseProxy": {
    "Routes": {
      "bff-route": {
        "ClusterId": "bff-cluster",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "bff-cluster": {
        "Destinations": {
          "bff": {
            "Address": "http://bff-api:8080"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:10"
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
