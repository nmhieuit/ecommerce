{
  "ReverseProxy": {
    "Routes": {
      "bff-route": {
        "ClusterId": "bff-cluster",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "bff-cluster": {
        "Destinations": {
          "bff": {
            "Address": "http://bff-api:8080"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:10"
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
