    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- No Testcontainers.MsSql here, unlike the domain services' integration tests: the gateway is a
