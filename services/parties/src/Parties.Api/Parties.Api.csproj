<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\shared\ServiceDefaults\ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\..\..\shared\Tenancy\Tenancy.csproj" />
    <!-- Not yet consumed at Setup/Foundational time (tasks.md T007) — wiring
         AddIdentityValidation()/UseIdentityValidation() into Program.cs is User Story 2's job
         (tasks.md T035). -->
    <ProjectReference Include="..\..\..\..\shared\Identity\Identity.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.Diagnostics.HealthChecks itself ships in the ASP.NET Core shared
         framework; only the EF Core integration (AddDbContextCheck<T>) needs referencing. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Readiness opens a raw connection rather than resolving the DbContext: since
         003-stub-identity-tenant-context the context requires a resolved tenant, which a
         Kubernetes probe (calling /health/ready directly, never through the gateway) does not have. -->
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <!-- Design-time only: supplies the `dotnet ef migrations` tooling. PrivateAssets="all" keeps
         it out of the published image, which must never carry migration tooling into production. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
