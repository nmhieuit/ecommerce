# .NET / C#
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
# Anchored to the repository root on purpose: this is NuGet's legacy restore folder, and an
# unanchored `packages/` would also swallow frontend/packages/, where the generated API client lives.
/packages/
*.nupkg

# Rider / VS / VS Code
.vs/
.vscode/
.idea/
*.iml

# SonarScanner working directories (spec 012-sonarqube-quality-gate)
.sonarqube/
.scannerwork/

# Test / coverage output
[Tt]est[Rr]esult*/
*.trx
coverage/
*.coverage
*.coveragexml

# Node (frontend)
node_modules/
dist/
build/
.turbo/
.pnpm-store/
*.tsbuildinfo

# Playwright output
test-results/
playwright-report/
blob-report/
.playwright/

# Environment / secrets
.env
.env.*
# ...except the committed template a fresh clone needs to bring up its own database
# container (quickstart.md, SC-001). It holds no real secret.
!.env.example

# OS cruft
.DS_Store
Thumbs.db
*.tmp
*.swp

# Local override configs
appsettings.*.local.json

# Demo run output (006-e2e-order-demo)
# The video recording and the raw evidence the demo produces. Deliberately not committed: the
# repository has no binary-asset convention, and a video re-recorded on every change would
# accumulate in history forever. The committed evidence is docs/demo-phase-1.md and the stills in
# docs/demo/, which this rule does not touch.
artifacts/

# Local CI credentials (012-sonarqube-quality-gate). Never committed: these are real tokens for
# the local Jenkins/SonarQube stack in docker-compose.ci.yml.
.ci-secrets/
