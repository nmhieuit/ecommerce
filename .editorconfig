root = true

[*]
indent_style = space
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:warning

# Nullable reference type warnings are errors platform-wide (constitution: Backend constraints)
dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.CS8602.severity = error
dotnet_diagnostic.CS8603.severity = error
dotnet_diagnostic.CS8604.severity = error

# Naming: PascalCase for types/members, camelCase for locals/parameters
dotnet_naming_rule.types_pascal_case.severity = warning
dotnet_naming_rule.types_pascal_case.symbols = types
dotnet_naming_rule.types_pascal_case.style = pascal_case
dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum
dotnet_naming_style.pascal_case.capitalization = pascal_case

# EF Core writes these files; nobody hand-maintains them, and `dotnet ef migrations add` will
# reproduce the same shapes on the next migration. Style rules that a developer cannot act on
# without editing generated output are noise, so they are scoped off here rather than suppressed
# platform-wide — hand-written code keeps every one of them.
#
# CA1861: migrations pass column-name arrays inline to InsertData/UpdateData. The rule's premise
# (a method called repeatedly in a hot path) does not hold for a migration that runs once.
[**/Migrations/*.cs]
dotnet_diagnostic.CA1861.severity = none

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
